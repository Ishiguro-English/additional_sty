\NeedsTeXFormat{pLaTeX2e}
\ProvidesPackage{座席表}[2026/08/06, ver.1.0.0]

\RequirePackage{graphicx}
\RequirePackage{varwidth}
\RequirePackage{xfp}

\newsavebox{\AutoResizeBox}

\makeatletter

\newenvironment{AutoResize}[2]{%
  \def\AutoResizeWidth{#1}%
  \def\AutoResizeHeight{#2}%
  \begin{lrbox}{\AutoResizeBox}%
  \begin{varwidth}{1000pt}%
}{%
  \end{varwidth}%
  \end{lrbox}%
  \AutoResizeScale
}

\newcommand{\AutoResizeScale}{%
  \dimen0=\wd\AutoResizeBox
  \dimen2=\dimexpr\ht\AutoResizeBox+\dp\AutoResizeBox\relax

  \dimen4=\AutoResizeWidth
  \dimen6=\AutoResizeHeight

  \edef\ARScale{%
    \fpeval{
      min(
        \strip@pt\dimen4/\strip@pt\dimen0,
        \strip@pt\dimen6/\strip@pt\dimen2
      )
    }
  }%

  \scalebox{\ARScale}{\usebox{\AutoResizeBox}}%
}

\makeatother

