\def\FUbox@getlasttok#1#2\relax{%
\def\FUbox@lasttok{#1}%
\ifx\relax#2\relax\else
  \expandafter\FUbox@getlasttok#2\relax
\fi
}
\def\FUbox@setradius#1{%
\edef\FUbox@tmp{\zap@space#1 \@empty}%
\expandafter\FUbox@getlasttok\FUbox@tmp\relax
\ifcat a\FUbox@lasttok
  \FUbox@radiusdim=\FUbox@tmp\relax
\else
  \FUbox@radiusdim=\FUbox@tmp cm\relax
\fi
\FUbox@radiusgiventrue
}
\def\FUbox@applyequaldefaultoptions#1{\pgfkeys{/FUbox/.cd,#1}}
\def\FUbox@applyBrep#1{%
\count@=#1\relax
\advance\count@ by -1\relax
\dimen@=\count@\FUbox@halfzh\relax
\FUbox@yshift=0pt\relax
\advance\FUbox@yshift by -\dimen@\relax
}
\def\FUbox@applyTrep#1{%
\count@=#1\relax
\advance\count@ by -1\relax
\dimen@=\count@\FUbox@halfzh\relax
\FUbox@yshift=1zh\relax
\advance\FUbox@yshift by \dimen@\relax
}
\def\FUbox@applyCrep#1{%
\count@=#1\relax
\advance\count@ by -1\relax
\dimen@=\count@\FUbox@halfzh\relax
\FUbox@yshift=.3zh\relax
\advance\FUbox@yshift by \dimen@\relax
}
\def\FUbox@applyLrep#1{%
\count@=#1\relax
\dimen@=\count@\FUbox@halfzw\relax
\advance\FUbox@xshift by -\dimen@\relax
}
\def\FUbox@applyRrep#1{%
\count@=#1\relax
\dimen@=\count@\FUbox@halfzw\relax
\advance\FUbox@xshift by \dimen@\relax
}
\def\FUbox@countRest#1{%
\ifx#1\relax
  \let\FUbox@next\relax
\else
  \def\FUbox@tmpa{#1}%
  \ifx\FUbox@tmpa\FUbox@target
    \advance\FUbox@repcount by 1\relax
    \let\FUbox@next\FUbox@countRest
  \else
    \FUbox@repcount=0\relax
    \let\FUbox@next\FUbox@countRestSkip
  \fi
\fi
\FUbox@next
}
\def\FUbox@countRestSkip#1{%
\ifx#1\relax
  \let\FUbox@next\relax
\else
  \let\FUbox@next\FUbox@countRestSkip
\fi
\FUbox@next
}
\def\FUbox@handleUnknown#1{%
\edef\FUbox@unknownname{#1}%
\expandafter\FUbox@handleUnknownI\FUbox@unknownname\relax
}
\def\FUbox@handleUnknownI#1#2\relax{%
\def\FUbox@target{#1}%
\FUbox@repcount=1\relax
\FUbox@countRest#2\relax
\ifnum\FUbox@repcount>0\relax
  \ifx\FUbox@target\FUbox@b
    \FUbox@applyBrep{\the\FUbox@repcount}%
  \else\ifx\FUbox@target\FUbox@t
    \FUbox@applyTrep{\the\FUbox@repcount}%
  \else\ifx\FUbox@target\FUbox@c
    \FUbox@applyCrep{\the\FUbox@repcount}%
  \else\ifx\FUbox@target\FUbox@l
    \FUbox@applyLrep{\the\FUbox@repcount}%
  \else\ifx\FUbox@target\FUbox@r
    \FUbox@applyRrep{\the\FUbox@repcount}%
  \else
    \PackageError{FUbox}{Unknown key `\FUbox@unknownname'}{Key `\FUbox@unknownname' is not defined.}%
  \fi\fi\fi\fi\fi
\else
  \PackageError{FUbox}{Unknown key `\FUbox@unknownname'}{Key `\FUbox@unknownname' is not defined.}%
\fi
}

\def\FUbox@setreservewidth#1{%
\edef\FUbox@tmp{\zap@space#1 \@empty}%
\ifx\FUbox@tmp\FUbox@autosymbol
