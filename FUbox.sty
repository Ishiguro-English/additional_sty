\newcommand{\setupFUbox}[1]{\pgfkeys{/FUboxsetup,#1}}
% -----------------------------------------------------------------------------
% 自動 radius 計算
% -----------------------------------------------------------------------------
\def\FUbox@compute_autoradius{%
\dimen@=\FUbox@hx\relax \edef\FUbox@hxpt{\strip@pt\dimen@}%
\dimen@=\FUbox@hy\relax \edef\FUbox@hypt{\strip@pt\dimen@}%
\dimen@=\FUbox@tipout\relax \edef\FUbox@tippt{\strip@pt\dimen@}%
\pgfmathsetmacro{\FUbox@cap}{8000}%
\pgfmathsetmacro{\FUbox@craw}{abs(cos(\FUbox@angle))}%
\pgfmathsetmacro{\FUbox@sraw}{abs(sin(\FUbox@angle))}%
\pgfmathsetmacro{\FUbox@epsx}{\FUbox@hxpt/\FUbox@cap}%
\pgfmathsetmacro{\FUbox@epsy}{\FUbox@hypt/\FUbox@cap}%
\pgfmathsetmacro{\FUbox@cabs}{max(\FUbox@craw,\FUbox@epsx)}%
\pgfmathsetmacro{\FUbox@sabs}{max(\FUbox@sraw,\FUbox@epsy)}%
\pgfmathsetmacro{\FUbox@tx}{\FUbox@hxpt/\FUbox@cabs}%
\pgfmathsetmacro{\FUbox@ty}{\FUbox@hypt/\FUbox@sabs}%
\pgfmathsetmacro{\FUbox@tmin}{min(\FUbox@tx,\FUbox@ty)}%
\pgfmathsetmacro{\FUbox@rpt}{max(\FUbox@tmin + \FUbox@tippt, 0.1)}%
\pgfmathsetlength{\FUbox@centerdist}{\FUbox@rpt pt}%
}

\def\FUbox@setreserveactive{%
\FUbox@reserveactivefalse
\ifFUbox@reservewidthauto\FUbox@reserveactivetrue\fi
\ifFUbox@reservewidthfixed\FUbox@reserveactivetrue\fi
\ifFUbox@reserveheightauto\FUbox@reserveactivetrue\fi
\ifFUbox@reserveheightfixed\FUbox@reserveactivetrue\fi
\ifFUbox@reservedepthauto\FUbox@reserveactivetrue\fi
\ifFUbox@reservedepthfixed\FUbox@reserveactivetrue\fi
}
\def\FUbox@computereserve{%
\pgfmathsetlength{\FUbox@cx}{\FUbox@centerdist*cos(\FUbox@angle)+\FUbox@boxxshift}%
\pgfmathsetlength{\FUbox@cy}{\FUbox@centerdist*sin(\FUbox@angle)+\FUbox@boxyshift}%
\FUbox@leftedge=\dimexpr\FUbox@cx-\FUbox@hx\relax
\FUbox@rightedge=\dimexpr\FUbox@cx+\FUbox@hx\relax
\FUbox@bottomedge=\dimexpr\FUbox@cy-\FUbox@hy\relax
\FUbox@topedge=\dimexpr\FUbox@cy+\FUbox@hy\relax
\advance\FUbox@leftedge by \FUbox@xshift\relax
\advance\FUbox@rightedge by \FUbox@xshift\relax
\advance\FUbox@bottomedge by \FUbox@yshift\relax
\advance\FUbox@topedge by \FUbox@yshift\relax
\ifdim\FUbox@leftedge>0pt\relax\FUbox@leftedge=0pt\relax\fi
\ifdim\FUbox@rightedge<0pt\relax\FUbox@rightedge=0pt\relax\fi
\ifdim\FUbox@bottomedge>0pt\relax\FUbox@bottomedge=0pt\relax\fi
\ifdim\FUbox@topedge<0pt\relax\FUbox@topedge=0pt\relax\fi
\FUbox@autoreservewidth=\dimexpr\FUbox@rightedge-\FUbox@leftedge\relax
\FUbox@autoreserveheight=\FUbox@topedge\relax
\FUbox@autoreservedepth=-\FUbox@bottomedge\relax
\ifFUbox@reservewidthauto\FUbox@reservewidth=\FUbox@autoreservewidth\relax\fi
\ifFUbox@reserveheightauto\FUbox@reserveheight=\FUbox@autoreserveheight\relax\fi
\ifFUbox@reservedepthauto\FUbox@reservedepth=\FUbox@autoreservedepth\relax\fi
\FUbox@reserveactivefalse
\ifFUbox@reservewidthauto\FUbox@reserveactivetrue\fi
\ifFUbox@reservewidthfixed\FUbox@reserveactivetrue\fi
\ifFUbox@reserveheightauto\FUbox@reserveactivetrue\fi
\ifFUbox@reserveheightfixed\FUbox@reserveactivetrue\fi
\ifFUbox@reservedepthauto\FUbox@reserveactivetrue\fi
\ifFUbox@reservedepthfixed\FUbox@reserveactivetrue\fi
}
\def\FUbox@reserveout{%
\ifdim\FUbox@reservewidth<0pt\relax\FUbox@reservewidth=0pt\relax\fi
\ifdim\FUbox@reserveheight<0pt\relax\FUbox@reserveheight=0pt\relax\fi
\ifdim\FUbox@reservedepth<0pt\relax\FUbox@reservedepth=0pt\relax\fi
\ifmmode
  \hbox to \FUbox@reservewidth{\vrule width 0pt height \FUbox@reserveheight depth \FUbox@reservedepth\hfil}%
\else
  \vrule width 0pt height \FUbox@reserveheight depth \FUbox@reservedepth\relax
  \kern\FUbox@reservewidth\relax
\fi
}

% -----------------------------------------------------------------------------
% reserve なしの描画
% -----------------------------------------------------------------------------
\def\FUbox@drawout{%
\smash{\hbox to 0pt{\kern\FUbox@drawkern\raisebox{\the\FUbox@yshift}{\begin{tikzpicture}[baseline=0pt]
\useasboundingbox (0,0) rectangle (0,0);
\tikzset{FUboxCurrentBoxLineWidth/.style/.expanded={\FUbox@boxlinewidth}}%
\tikzset{FUboxCurrentTipLineWidth/.style/.expanded={\FUbox@tiplinewidth}}%
\tikzset{FUboxNodeStyle/.style={inner sep=\the\FUbox@sep,fill=\FUbox@fillcolor,draw=\FUbox@boxdrawcolor,FUboxCurrentBoxLineWidth,rounded corners=\the\FUbox@cornerradius}}%
\tikzset{FUboxtipStyle/.style={draw=\FUbox@tipdrawcolor,FUboxCurrentTipLineWidth}}%
\tikzset{FUboxNodeUser/.style={\FUbox@boxoptsexpanded}}%
\tikzset{FUboxtipUser/.style={\FUbox@tipoptsexpanded}}%
\coordinate (FUboxO) at (0,0);
\coordinate (FUboxCenterBase) at (\FUbox@angle:\the\FUbox@centerdist);
\coordinate (FUboxCenter) at ($(FUboxCenterBase)+(\the\FUbox@boxxshift,\the\FUbox@boxyshift)$);
\node[FUboxNodeStyle,FUboxNodeUser] (FUboxN) at (FUboxCenter) {\FUcontent};
\path[name path=FUboxRect] (FUboxN.south west) rectangle (FUboxN.north east);
\path[name path=FUboxRay] (FUboxO) -- ++(\FUbox@angle:200cm);
\path[name intersections={of=FUboxRect and FUboxRay, name=FUboxI, sort by=FUboxRay}];
\coordinate (FUboxHit) at (FUboxI-1);
\path let \p1=(FUboxHit) in \pgfextra{%
\dimen@=\x1\relax\edef\FUbox@hitx{\strip@pt\dimen@}%
\dimen@=\y1\relax\edef\FUbox@hity{\strip@pt\dimen@}%
\dimen@=\FUbox@tipsharpness\relax\edef\FUbox@ashpt{\strip@pt\dimen@}%
\pgfmathsetmacro{\FUbox@dhit}{max(veclen(\FUbox@hitx,\FUbox@hity),0.001)}%
\pgfmathsetmacro{\FUbox@eps}{atan(\FUbox@ashpt/\FUbox@dhit)}%
\pgfmathsetmacro{\FUbox@tmpOne}{\FUbox@angle+\FUbox@eps}%
\pgfmathsetmacro{\FUbox@tmpTwo}{\FUbox@angle-\FUbox@eps}%
\xdef\FUbox@dirone{\FUbox@tmpOne}%
\xdef\FUbox@dirtwo{\FUbox@tmpTwo}%
};
\path[name path=FUboxLone] (FUboxO) -- ++(\FUbox@dirone:200cm);
\path[name path=FUboxLtwo] (FUboxO) -- ++(\FUbox@dirtwo:200cm);
\path[name intersections={of=FUboxRect and FUboxLone, name=FUboxQone, sort by=FUboxLone}];
\path[name intersections={of=FUboxRect and FUboxLtwo, name=FUboxQtwo, sort by=FUboxLtwo}];
\coordinate (FUboxQoneP) at (FUboxQone-1);
\coordinate (FUboxQtwoP) at (FUboxQtwo-1);
\fill[draw=none,fill=\FUbox@fillcolor] (FUboxQoneP)--(FUboxO)--(FUboxQtwoP)--cycle;
\draw[line width=\the\FUbox@coverlinewidth,draw=\FUbox@fillcolor,line cap=butt,line join=miter] (FUboxQoneP)--(FUboxQtwoP);
\draw[FUboxtipStyle,FUboxtipUser,line cap=round,line join=round] (FUboxQoneP)--(FUboxO)--(FUboxQtwoP);
\end{tikzpicture}}\hss}}%
}

% -----------------------------------------------------------------------------
% reserve ありのときに使う自然サイズ TikZ
% -----------------------------------------------------------------------------
\def\FUbox@naturalpicture{%
\begin{tikzpicture}[baseline=0pt]
\tikzset{FUboxCurrentBoxLineWidth/.style/.expanded={\FUbox@boxlinewidth}}%
\tikzset{FUboxCurrentTipLineWidth/.style/.expanded={\FUbox@tiplinewidth}}%
\tikzset{FUboxNodeStyle/.style={inner sep=\the\FUbox@sep,fill=\FUbox@fillcolor,draw=\FUbox@boxdrawcolor,FUboxCurrentBoxLineWidth,rounded corners=\the\FUbox@cornerradius}}%
\tikzset{FUboxtipStyle/.style={draw=\FUbox@tipdrawcolor,FUboxCurrentTipLineWidth}}%
\tikzset{FUboxNodeUser/.style={\FUbox@boxoptsexpanded}}%
\tikzset{FUboxtipUser/.style={\FUbox@tipoptsexpanded}}%
\coordinate (FUboxO) at (\the\FUbox@xshift,\the\FUbox@yshift);
\coordinate (FUboxCenterBase) at ($(FUboxO)+(\FUbox@angle:\the\FUbox@centerdist)$);
\coordinate (FUboxCenter) at ($(FUboxCenterBase)+(\the\FUbox@boxxshift,\the\FUbox@boxyshift)$);
\node[FUboxNodeStyle,FUboxNodeUser] (FUboxN) at (FUboxCenter) {\FUcontent};
\path[overlay,name path=FUboxRect] (FUboxN.south west) rectangle (FUboxN.north east);
\path[overlay,name path=FUboxRay] (FUboxO) -- ++(\FUbox@angle:200cm);
\path[overlay,name intersections={of=FUboxRect and FUboxRay, name=FUboxI, sort by=FUboxRay}];
\coordinate (FUboxHit) at (FUboxI-1);
\path[overlay] let \p1=(FUboxHit), \p2=(FUboxO) in \pgfextra{%
\dimen@=\dimexpr\x1-\x2\relax\edef\FUbox@hitx{\strip@pt\dimen@}%
\dimen@=\dimexpr\y1-\y2\relax\edef\FUbox@hity{\strip@pt\dimen@}%
\dimen@=\FUbox@tipsharpness\relax\edef\FUbox@ashpt{\strip@pt\dimen@}%
\pgfmathsetmacro{\FUbox@dhit}{max(veclen(\FUbox@hitx,\FUbox@hity),0.001)}%
\pgfmathsetmacro{\FUbox@eps}{atan(\FUbox@ashpt/\FUbox@dhit)}%
\pgfmathsetmacro{\FUbox@tmpOne}{\FUbox@angle+\FUbox@eps}%
\pgfmathsetmacro{\FUbox@tmpTwo}{\FUbox@angle-\FUbox@eps}%
\xdef\FUbox@dirone{\FUbox@tmpOne}%
\xdef\FUbox@dirtwo{\FUbox@tmpTwo}%
};
\path[overlay,name path=FUboxLone] (FUboxO) -- ++(\FUbox@dirone:200cm);
\path[overlay,name path=FUboxLtwo] (FUboxO) -- ++(\FUbox@dirtwo:200cm);
\path[overlay,name intersections={of=FUboxRect and FUboxLone, name=FUboxQone, sort by=FUboxLone}];
\path[overlay,name intersections={of=FUboxRect and FUboxLtwo, name=FUboxQtwo, sort by=FUboxLtwo}];
\coordinate (FUboxQoneP) at (FUboxQone-1);
\coordinate (FUboxQtwoP) at (FUboxQtwo-1);
\fill[draw=none,fill=\FUbox@fillcolor] (FUboxQoneP)--(FUboxO)--(FUboxQtwoP)--cycle;
\draw[line width=\the\FUbox@coverlinewidth,draw=\FUbox@fillcolor,line cap=butt,line join=miter] (FUboxQoneP)--(FUboxQtwoP);
\draw[FUboxtipStyle,FUboxtipUser,line cap=round,line join=round] (FUboxQoneP)--(FUboxO)--(FUboxQtwoP);
\end{tikzpicture}%
}
% -----------------------------------------------------------------------------
% reserve ありの出力
% -----------------------------------------------------------------------------
\def\FUbox@reserveboxout{%
\FUbox@computereserve
\ifdim\FUbox@reservewidth<0pt\relax\FUbox@reservewidth=0pt\relax\fi
\ifdim\FUbox@reserveheight<0pt\relax\FUbox@reserveheight=0pt\relax\fi
\ifdim\FUbox@reservedepth<0pt\relax\FUbox@reservedepth=0pt\relax\fi
\ifFUbox@reservewidthauto
  \FUbox@outleft=\FUbox@leftedge\relax
\else
  \FUbox@outleft=0pt\relax
\fi
\FUbox@drawkern=\dimexpr\FUbox@xshift-\FUbox@outleft\relax
\kern\FUbox@outleft\relax
\hbox to \FUbox@reservewidth{\vrule width 0pt height \FUbox@reserveheight depth \FUbox@reservedepth\relax\FUbox@drawout\hss}%
}

\def\FUbox@equalleft{%
\mathchoice{\FUbox@equalleft@do\displaystyle}{\FUbox@equalleft@do\textstyle}{\FUbox@equalleft@do\scriptstyle}{\FUbox@equalleft@do\scriptscriptstyle}%
}
\def\FUbox@equalleft@do#1{%
\setbox\z@=\hbox{$#1\m@th=$}%
\setbox\tw@=\hbox{$#1\m@th\mskip\thickmuskip$}%
\dimen@=\dimexpr\wd\tw@+\wd\z@/2\relax
\kern-\dimen@
}
\def\FUbox@equalright{%
\mathchoice{\FUbox@equalright@do\displaystyle}{\FUbox@equalright@do\textstyle}{\FUbox@equalright@do\scriptstyle}{\FUbox@equalright@do\scriptscriptstyle}%
}
\def\FUbox@equalright@do#1{%
\setbox\z@=\hbox{$#1\m@th=$}%
\setbox\tw@=\hbox{$#1\m@th\mskip\thickmuskip$}%
\dimen@=\dimexpr\wd\tw@+\wd\z@/2\relax
\kern\dimen@
}
% -----------------------------------------------------------------------------
% ユーザーコマンド \FUbox（\newcommand による実装）
% -----------------------------------------------------------------------------
\newcommand{\FUbox}[2][]{%
\begingroup
\FUbox@resetdefaults
\pgfkeys{/FUbox,#1}%
\FUbox@detectpar{#2}%
\ifFUbox@widthgiven
  \FUbox@realwidth=\FUbox@width\relax
\else
  \ifFUbox@haspar
    \FUbox@realwidth=\FUbox@maxwidth\relax
  \else
    \setbox\FUbox@measurebox=\hbox{\begin{tabular}{@{}c@{}}\FUbox@beforecontents\ignorespaces#2\unskip\FUbox@aftercontents\end{tabular}}%
    \ifdim\wd\FUbox@measurebox>\FUbox@maxwidth\relax
      \FUbox@realwidth=\FUbox@maxwidth\relax
    \else
      \FUbox@realwidth=\wd\FUbox@measurebox\relax
    \fi
  \fi
\fi
\long\def\FUcontent{\begin{minipage}{\FUbox@realwidth}{\FUbox@beforecontents#2\FUbox@aftercontents\par}\end{minipage}}%
\setbox\FUbox@contentbox=\hbox{\FUcontent}%
\FUbox@hx=\dimexpr\wd\FUbox@contentbox/2+\FUbox@sep\relax
\FUbox@hy=\dimexpr(\ht\FUbox@contentbox+\dp\FUbox@contentbox)/2+\FUbox@sep\relax
\ifFUbox@radiusgiven
  \FUbox@centerdist=\FUbox@radiusdim\relax
\else
  \FUbox@compute_autoradius
\fi
\FUbox@setreserveactive
\edef\FUbox@boxoptsexpanded{\FUbox@boxoptions}%
\edef\FUbox@tipoptsexpanded{\FUbox@tipoptions}%
\ifFUbox@equal\ifmmode\FUbox@equalleft\fi\fi
\ifmmode\else\leavevmode\fi
\ifFUbox@reserveactive
  \FUbox@reserveboxout
\else
  \FUbox@drawkern=\FUbox@xshift\relax
  \FUbox@drawout
\fi
\ifFUbox@equal\ifmmode\FUbox@equalright\fi\fi
\endgroup
\ignorespaces
}
\makeatother
\endinput
