% -----------------------------------------------------------------------------
% FUbox.sty
% -----------------------------------------------------------------------------
% このパッケージは，本文や数式の現在位置を基準点として，先端付きの小箱
% （吹き出し）を重ねて描画するためのものです．
%
% 基本の考え方は次の通りです．
% 1. \FUbox{...} の中身を一度組んで，その自然幅・高さを測る．
% 2. width が指定されていれば固定幅，指定されていなければ max width 以内の
%    自然幅で minipage を作る．
% 3. 先端の位置を (0,0) とし，angle 方向に箱本体の中心を置く．
% 4. TikZ で箱本体・先端の三角形・境界消し用の線を描く．
% 5. reserve 系キーがない場合は，描画結果を smash して本文レイアウトに
%    ほとんど影響させない．
% 6. reserve 系キーがある場合は，実際の TikZ の外接サイズを測り，その幅・高さ・
%    深さを本文レイアウトに予約する．
%
% v5 での既定値：
%   ・向きは right（angle=0）
%   ・縦位置は c 相当（yshift=.3zh）
% つまり \FUbox{...} は概ね \FUbox[c,right]{...} と同じ位置関係になります．
% -----------------------------------------------------------------------------
\def\FUboxfillcolor{white}
\def\FUboxdrawcolor{black}
\def\FUboxtipcolor{black}
\def\FUboxlinewidth{thin}
\def\FUboxsep{3pt}
\def\FUtipsharpness{3pt}
\def\FUboxroundedradius{3pt}
\def\FUboxboxoptions{}% 追加：箱の既定TikZオプション
\def\FUboxtipoptions{}% 追加：先端の既定TikZオプション
\long\def\FUboxbeforecontents{}% 追加：内容の直前に入れる既定コード
\long\def\FUboxaftercontents{}% 追加：内容の直後に入れる既定コード
\newdimen\FUboxDefaultMaxWidth
\FUboxDefaultMaxWidth=10zw\relax
\newcommand{\FUboxSetDefaultMaxWidth}[1]{\FUboxDefaultMaxWidth=#1\relax}
\newdimen\FUboxDefaultTipOut
\FUboxDefaultTipOut=.5cm\relax
\newcommand{\FUboxSetDefaultTipOut}[1]{\FUboxSetDefaultTipOut=#1\relax}
\newdimen\FUboxDefaultCoverLineWidth
\FUboxDefaultCoverLineWidth=2pt\relax
\newcommand{\FUboxSetDefaultCoverLineWidth}[1]{\FUboxSetDefaultCoverLineWidth=#1\relax}
% -----------------------------------------------------------------------------
% 位置に関する既定値
% -----------------------------------------------------------------------------
% \FUbox のオプションを何も指定しないときに使う基準位置です．
% 以前の版では below 相当（angle=-90）が既定でしたが，v5 では右向きに変更しました．
% また，右向きの吹き出しでは，本文の基準線と箱の中心が少しずれるため，
% c キーと同じ yshift=.3zh を既定にしています．
\newdimen\FUboxDefaultXShift
\newdimen\FUboxDefaultYShift
\FUboxDefaultXShift=0pt\relax
\FUboxDefaultYShift=.3zh\relax
\def\FUboxDefaultAngle{0}
\newcommand{\FUboxSetDefaultBoxOptions}[1]{\def\FUboxboxoptions{#1}}% 追加
\newcommand{\FUboxSetDefaultTipOptions}[1]{\def\FUboxtipoptions{#1}}% 追加

\makeatletter
% -----------------------------------------------------------------------------
% 線幅マクロ設定（Expl3 非依存の実装）
% -----------------------------------------------------------------------------
\def\FUbox@trimspaces#1{%
  \edef#1{\expandafter\zap@space#1 \@empty}%
}

\def\FUbox@setlinewidthmacro#1#2{%
  \edef\FUbox@lw@tmp{#2}%
  \FUbox@trimspaces\FUbox@lw@tmp
  \def\FUbox@lw@matched{0}%
  \def\FUbox@checklw##1{%
    \def\FUbox@lw@cand{##1}%
    \FUbox@trimspaces\FUbox@lw@cand
    \ifx\FUbox@lw@tmp\FUbox@lw@cand
      \def\FUbox@lw@matched{1}%
    \fi
  }%
  \FUbox@checklw{ultra thin}%
  \FUbox@checklw{very thin}%
  \FUbox@checklw{thin}%
  \FUbox@checklw{semithick}%
  \FUbox@checklw{thick}%
  \FUbox@checklw{very thick}%
  \FUbox@checklw{ultra thick}%
  \if1\FUbox@lw@matched
    \expandafter\let\csname #1\endcsname\FUbox@lw@tmp
  \else
    \expandafter\FUbox@checkequal\FUbox@lw@tmp=\FUbox@nil
    \if1\FUbox@has@equal
      \expandafter\let\csname #1\endcsname\FUbox@lw@tmp
    \else
      \expandafter\edef\csname #1\endcsname{line width=\FUbox@lw@tmp}%
    \fi
  \fi
}

\def\FUbox@checkequal#1=#2\FUbox@nil{%
  \def\FUbox@chk{#2}%
  \ifx\FUbox@chk\@empty
    \def\FUbox@has@equal{0}%
  \else
    \def\FUbox@has@equal{1}%
  \fi
}

