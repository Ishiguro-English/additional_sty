%%% interface commands
\DeclareRobustCommand{\jegg}{%
  \@ifstar
    {\kks@autolowercase@select{\jegg@new@black@no}{\jegg@new@black}}
    {\kks@autolowercase@select{\jegg@new@no}{\jegg@new}}%
}
