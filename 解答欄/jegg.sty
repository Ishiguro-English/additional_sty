\RequirePackage{kvoptions}
\RequirePackage{calc}
\RequirePackage{tikz}
  \usetikzlibrary{shapes.geometric}

%%% package options
\SetupKeyvalOptions{%
  family=jegg,%
  prefix=jegg@%
}
\DeclareStringOption[1]{tsumesuji}
\DeclareStringOption[1]{autolowercase}
\DeclareStringOption[auto]{linewidth}
\DeclareStringOption[auto]{jegglinewidth}
\ProcessKeyvalOptions*
%%%

%%% Pure TeX helpers (tsumesuji, autolowercase, digit check)
\def\kks@invalid@option#1#2{%
  \PackageError{jegg}{Invalid `#1` option value `#2`}{}%
}

\newif\ifkks@autolowercase
\ifnum\jegg@autolowercase=1\relax
  \kks@autolowercasetrue
\else\ifnum\jegg@autolowercase=0\relax
  \kks@autolowercasefalse
\else
  \kks@autolowercasetrue
  \kks@invalid@option{autolowercase}{\jegg@autolowercase}%
\fi\fi

% 線幅解決（TikZのline width内でそのまま展開できるよう\defを使わずに判定）
\def\kks@auto@str{auto}
\newcommand{\kks@linewidth}[3]{%
  \ifnum\pdfstrcmp{#1}{auto}=0\relax
    \ifnum\pdfstrcmp{#2}{auto}=0\relax
      #3%
    \else
      #2%
    \fi
  \else
    #1%
  \fi
}

% ASCII小文字列判定（1文字以上かつすべて a-z の場合のみ真）
\newif\ifkks@islower
\newcommand{\kks@check@lowercase}[1]{%
  \begingroup
    \@ifundefined{Rrnum}{}{\let\Rrnum\kks@Rrnum@expand}%
    \@ifundefined{alphabetarray}{}{\let\alphabetarray\kks@alphabetarray@expand}%
    \edef\kks@scan@str{\detokenize{#1}}%
    \ifx\kks@scan@str\@empty
      \global\kks@islowerfalse
    \else
      \global\kks@islowertrue
      \expandafter\@tfor\expandafter\kks@ch\expandafter:\expandafter=\kks@scan@str\do{%
        \ifnum\expandafter`\kks@ch<`a\relax
          \global\kks@islowerfalse
        \else\ifnum\expandafter`\kks@ch>`z\relax
          \global\kks@islowerfalse
        \fi\fi
      }%
    \fi
  \endgroup
}

\newcommand{\kks@Rrnum@expand}{\@ifstar{\kks@Rrnum@s}{\kks@Rrnum@ns}}
\newcommand{\kks@Rrnum@s}[1]{\romannumeral #1}
\newcommand{\kks@Rrnum@ns}[1]{\uppercase\expandafter{\romannumeral #1}}

\ExplSyntaxOn
\NewExpandableDocumentCommand \kks@alphabetarray@expand: { s m }
  {
    \IfBooleanTF { #1 }
      { \seq_item:Nn \g_alphabet_upper_seq { #2 } }
      { \seq_item:Nn \g_alphabet_lower_seq { #2 } }
  }
\cs_new_eq:NN \kks@alphabetarray@expand \kks@alphabetarray@expand:
\ExplSyntaxOff

\newcommand{\kks@autolowercase@select}[3]{%
  \ifkks@autolowercase
    \kks@check@lowercase{#3}%
    \ifkks@islower
      #1{#3}%
    \else
      #2{#3}%
    \fi
  \else
    #2{#3}%
  \fi
}

% 詰め数字の実装（2桁以上の純粋な数字列の場合、「1」の横幅を75%に縮小）
\newif\ifkks@alldigits
\newcount\kks@digitcount
\DeclareRobustCommand{\kks@ShrinkedNumber@internal}[1]{%
  \edef\kks@scan@str{\detokenize{#1}}%
  \ifx\kks@scan@str\@empty
    #1%
  \else
    \kks@alldigitstrue
    \kks@digitcount=0\relax
    \expandafter\@tfor\expandafter\kks@ch\expandafter:\expandafter=\kks@scan@str\do{%
      \advance\kks@digitcount by 1\relax
      \ifnum\expandafter`\kks@ch<`0\relax
        \kks@alldigitsfalse
      \else\ifnum\expandafter`\kks@ch>`9\relax
        \kks@alldigitsfalse
      \fi\fi
    }%
    \ifkks@alldigits
      \ifnum\kks@digitcount>1\relax
        \expandafter\@tfor\expandafter\kks@ch\expandafter:\expandafter=\kks@scan@str\do{%
          \ifnum\expandafter`\kks@ch=`1\relax
            \scalebox{0.75}[1]{1}%
          \else
            \kks@ch
          \fi
        }%
      \else
        #1%
      \fi
    \else
      #1%
    \fi
  \fi
}

\ifnum\jegg@tsumesuji=1\relax
  \let\kks@ShrinkedNumber\kks@ShrinkedNumber@internal
\else\ifnum\jegg@tsumesuji=0\relax
  \let\kks@ShrinkedNumber\relax
\else
  \let\kks@ShrinkedNumber\kks@ShrinkedNumber@internal
  \kks@invalid@option{tsumesuji}{\jegg@tsumesuji}%
\fi\fi

% 1桁数字判定
\newif\ifkksdigit@maru@new
\newcommand{\kks@chech@maru@onedigit}[1]{%
  \edef\kks@scan@str{\detokenize{#1}}%
  \kksdigit@maru@newfalse
  \ifx\kks@scan@str\@empty\else
    \kks@alldigitstrue
    \kks@digitcount=0\relax
    \expandafter\@tfor\expandafter\kks@ch\expandafter:\expandafter=\kks@scan@str\do{%
      \advance\kks@digitcount by 1\relax
      \ifnum\expandafter`\kks@ch<`0\relax
        \kks@alldigitsfalse
      \else\ifnum\expandafter`\kks@ch>`9\relax
        \kks@alldigitsfalse
      \fi\fi
    }%
    \ifkks@alldigits
      \ifnum\kks@digitcount=1\relax
        \kksdigit@maru@newtrue
      \fi
    \fi
  \fi
}
