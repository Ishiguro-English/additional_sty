\NeedsTeXFormat{pLaTeX2e}
\ProvidesPackage{グラフ描画}[2026/10/08, ver.1.5.0]

\RequirePackage{tikz}
\RequirePackage{ifthen}
\RequirePackage{xkeyval}

\define@key{棒グラフ}{バーの色}{\def\棒グラフバーの色{#1}}
\define@key{棒グラフ}{バーの枠の色}{\def\棒グラフバーの枠の色{#1}}
\define@key{棒グラフ}{要素名の文字サイズ}{\def\棒グラフ要素名の文字サイズ{#1}}
\define@key{棒グラフ}{個数の文字サイズ}{\def\棒グラフ個数の文字サイズ{#1}}
\define@key{棒グラフ}{前の単位}{\def\棒グラフ単位前{#1}}
\define@key{棒グラフ}{後ろの単位}{\def\棒グラフ後ろの単位{#1}}
\define@key{棒グラフ}{後の単位}{\def\棒グラフ後ろの単位{#1}}
\define@key{棒グラフ}{中央揃え}{\def\棒グラフ中央揃え{#1}}
\define@key{棒グラフ}{タイトル}{\def\棒グラフタイトル{#1}}
\define@key{棒グラフ}{タイトル位置}{\def\棒グラフタイトル位置{#1}}
\define@key{棒グラフ}{フォント}{\def\棒グラフフォント{#1}}
\define@key{棒グラフ}{絵文字}{\def\棒グラフ一括絵文字{#1}}
\define@key{棒グラフ}{要素間の縦余白を追加}{\def\棒グラフ追加縦余白{#1}}
\define@key{棒グラフ}{最大長}{\def\棒グラフ最大長{#1}}
\define@key{棒グラフ}{要素名の位置}{\def\棒グラフ要素名揃え{#1}}
\define@key{棒グラフ}{要素名の右間隔}{\def\棒グラフ要素名右間隔{#1}}
\define@key{棒グラフ}{要素名と縦線の間隔}{\def\棒グラフ要素名右間隔{#1}}
\define@key{棒グラフ}{各要素の横幅}{\def\棒グラフ各要素の横幅{#1}}

\newcounter{棒グラフ要素数}
\newcounter{棒グラフ余白計算用}
\newlength{\棒グラフ一行の高さ}
\newlength{\棒グラフ累積余白}
\newlength{\棒グラフ計算幅}
\newlength{\棒グラフ仮幅}
\newlength{\棒グラフ最大要素名幅}

% 内部処理用の保持変数
\def\棒グラフ要素データ{}
\def\棒グラフ検出最大値{0}

\newenvironment{棒グラフ}[1][]{%
  \def\棒グラフバーの色{lightgray}%
  \def\棒グラフバーの枠の色{black}%
  \def\棒グラフ要素名の文字サイズ{\normalsize}%
  \def\棒グラフ個数の文字サイズ{\small}%
  \def\棒グラフ単位前{}%
  \def\棒グラフ後ろの単位{}%
  \def\棒グラフ中央揃え{しない}%
  \def\棒グラフタイトル{}%
  \def\棒グラフタイトル位置{上}%
  \def\棒グラフフォント{}%
  \def\棒グラフ一括絵文字{}%
  \def\棒グラフ追加縦余白{0pt}%
  \def\棒グラフ最大長{10em}%
  \def\棒グラフ要素名揃え{右}%
  \def\棒グラフ要素名右間隔{0.4em}%
  \def\棒グラフ各要素の横幅{}%
  \setkeys{棒グラフ}{#1}%
  % 初期化
  \gdef\棒グラフ要素データ{}%
  \gdef\棒グラフ検出最大値{0}%
  \setlength{\棒グラフ最大要素名幅}{0pt}%
  \setcounter{棒グラフ要素数}{1}%
}{%
  \ifthenelse{\equal{\棒グラフ中央揃え}{する}}{\begin{center*}}{}%
  \棒グラフフォント
  % 上部タイトル
  \ifthenelse{\equal{\棒グラフタイトル}{}}{}{%
    \ifthenelse{\equal{\棒グラフタイトル位置}{上}}{%
      \br{.3}\centerline{\棒グラフ要素名の文字サイズ\棒グラフタイトル}%
    }{}%
  }%
  \br{-.3}\begin{tikzpicture}[baseline=0pt]%
    % 一括描画の実行
    \棒グラフ要素データ
  \end{tikzpicture}%
  % 下部タイトル
  \ifthenelse{\equal{\棒グラフタイトル}{}}{}{%
    \ifthenelse{\equal{\棒グラフタイトル位置}{下}}{%
      \br{.3}\centerline{\棒グラフ要素名の文字サイズ\棒グラフタイトル}%
    }{}%
  }%
  \ifthenelse{\equal{\棒グラフ中央揃え}{する}}{\end{center*}}{}%
  \br{.5}\setcounter{棒グラフ要素数}{1}%
}

% 描画実体マクロ
\newcommand{\棒グラフ要素実体描画}[3][]{%
  % 行の高さ計算
  \setlength{\棒グラフ一行の高さ}{1.2em}%
  \multiply\棒グラフ一行の高さ by \the棒グラフ要素数\relax
  \ifnum\value{棒グラフ要素数}>1
    \setcounter{棒グラフ余白計算用}{\value{棒グラフ要素数}}%
    \addtocounter{棒グラフ余白計算用}{-1}%
    \setlength{\棒グラフ累積余白}{\棒グラフ追加縦余白}%
    \multiply\棒グラフ累積余白 by \value{棒グラフ余白計算用}\relax
    \addtolength{\棒グラフ一行の高さ}{\棒グラフ累積余白}%
  \fi

  % 各要素の横幅の指定有無に応じて長さを計算
  \ifthenelse{\equal{\棒グラフ各要素の横幅}{}}{%
    \pgfmathsetlength{\棒グラフ計算幅}{(#3 / \棒グラフ検出最大値) * \棒グラフ最大長}%
  }{%
    \pgfmathsetlength{\棒グラフ計算幅}{#3 * \棒グラフ各要素の横幅}%
  }%

  % 1.左側要素名#2の表示位置制御
  \ifthenelse{\equal{\棒グラフ要素名揃え}{左}}{%
    \draw(-\棒グラフ最大要素名幅 - \棒グラフ要素名右間隔, .6em-\棒グラフ一行の高さ)%
      node[right, font=\棒グラフ要素名の文字サイズ, inner xsep=0pt]{#2};
  }{%
    \draw(-\棒グラフ要素名右間隔, .6em-\棒グラフ一行の高さ)%
      node[left, font=\棒グラフ要素名の文字サイズ, inner xsep=0pt]{#2};
  }%

  % 2.絵文字の判定
  \def\今回使う絵文字{#1}%
  \ifthenelse{\equal{\今回使う絵文字}{}}{%
    \def\今回使う絵文字{\棒グラフ一括絵文字}%
  }{}%

  % 3.グラフ描画
  \ifthenelse{\equal{\今回使う絵文字}{}}{%
    % 長方形バー
    \draw[draw=\棒グラフバーの枠の色, fill=\棒グラフバーの色]%
      (0em, .9em-\棒グラフ一行の高さ) rectangle (\棒グラフ計算幅, .3em-\棒グラフ一行の高さ);
    \draw(\棒グラフ計算幅, .6em-\棒グラフ一行の高さ)%
      node[right, font=\棒グラフ個数の文字サイズ]{%
        \scalebox{.9}{\棒グラフ単位前}\hspace{0pt}#3\hspace{0pt}\scalebox{.9}{\棒グラフ後ろの単位}%
      };
  }{%
    % 絵文字
    \draw(0em,.6em-\棒グラフ一行の高さ)node[right, font=\棒グラフ個数の文字サイズ]{%
      \fornext{#3}{\今回使う絵文字}\hspace{0.3333em}%
      \scalebox{.9}{\棒グラフ単位前}\hspace{0pt}#3\hspace{0pt}\scalebox{.9}{\棒グラフ後ろの単位}%
    };
  }%

  % 4.縦軸
  \draw(0em,0em)--(0em,-\棒グラフ一行の高さ);
  \stepcounter{棒グラフ要素数}%
}

\newcommand{\要素}[3][]{%
  % #3を評価し現在の最大値と比較
  \pgfmathparse{#3 > \棒グラフ検出最大値 ? #3 : \棒グラフ検出最大値}%
  \xdef\棒グラフ検出最大値{\pgfmathresult}%

  % 要素名#2の文字幅を自動計測（without \vphantom）
  \settowidth{\棒グラフ仮幅}{\棒グラフ要素名の文字サイズ #2}%
  \ifdim\棒グラフ仮幅>\棒グラフ最大要素名幅
    \setlength{\棒グラフ最大要素名幅}{\棒グラフ仮幅}%
  \fi

  % \unexpandedを使い\vphantom{bp}が\xdefで展開されるのを防ぐ
  \toks0=\expandafter{\棒グラフ要素データ}%
  \xdef\棒グラフ要素データ{\the\toks0 \noexpand\棒グラフ要素実体描画[#1]{\unexpanded{\vphantom{bp}}#2}{#3}}%
}