% 表紙土台
\newcommand{\spFrameUnderlay@sp@one}[2]{%
  \draw[#1, opacity=0.36, line width=.6pt, rounded corners=2.2pt]
    ([xshift=.55zw, yshift=-.55zw]frame.north west)
    rectangle ([xshift=-.55zw, yshift=.55zw]frame.south east);
  \draw[#1, opacity=0.72, line width=.6pt, rounded corners=1.8pt]
    ([xshift=.95zw, yshift=-.95zw]frame.north west)
    rectangle ([xshift=-.95zw, yshift=.95zw]frame.south east);
  \filldraw[fill=#2, draw=#1, line width=.6pt] ([xshift=.55zw, yshift=-.55zw]frame.north west) circle (.5zw);
  \filldraw[fill=#2, draw=#1, line width=.6pt] ([xshift=-.55zw, yshift=-.55zw]frame.north east) circle (.5zw);
  \filldraw[fill=#2, draw=#1, line width=.6pt] ([xshift=.55zw, yshift=.55zw]frame.south west) circle (.5zw);
  \filldraw[fill=#2, draw=#1, line width=.6pt] ([xshift=-.55zw, yshift=.55zw]frame.south east) circle (.5zw);
}

% 全面フレーム箱
\newtcolorbox{spcoverframe@sp@one}[1]{%
  enhanced, breakable=false, height=\spcoverH@sp@one,
  halign=center, valign=center,
  colback=white, colframe=white, boxrule=0pt, arc=4pt,
  left=6mm, right=6mm, top=6mm, bottom=6mm,
  underlay={\spFrameUnderlay@sp@one{メイン枠線}{white}#1}}

% \spMakeCover{エクスプ}{主題}{回など}{フッタ}
\NewDocumentCommand{\spMakeCover}{ m m m m }{%
  \clearpage\thispagestyle{empty}%
  \setlength{\spcoverH@sp@one}{\dimexpr\textheight-2mm\relax}%
  \begin{spcoverframe@sp@one}{%
    \begin{tcbclipinterior}
      \draw[メイン枠線, opacity=.07, line width=.8pt] (interior.center) circle (6.2cm);
      \draw[メイン枠線, opacity=.12, line width=.6pt, dash pattern=on .5pt off 3.4pt]
        (interior.center) circle (4.6cm);
      \draw[メイン枠線, opacity=.10, line width=.7pt] (interior.center) circle (3.2cm);
      \fill[メイン枠線, opacity=.22] ([yshift=6.2cm]interior.center) circle (3.2pt);
    \end{tcbclipinterior}}%
    {\gtfamily[5]\large\color{フッタ}#1}\\[12pt]
    {\gtfamily[8]\fontsize{32}{38}\selectfont\color{メイン枠線}#2}\\[16pt]
    {\gtfamily[6]\Large\color{タイトル}#3}\\[10pt]
    \tikz{\draw[メイン枠線, line width=1pt, line cap=round]
      (0,0) .. controls (1.1zw,.5zw) and (2.1zw,.5zw) .. (3.2zw,0);}\\[42pt]
    {\gtfamily[5]\color{フッタ}\small#4}%
  \end{spcoverframe@sp@one}%
  \clearpage}

% \spMakeBackCover{主題}{副題}{注記1}{注記2}
\NewDocumentCommand{\spMakeBackCover}{ m m m m }{%
  \clearpage\thispagestyle{empty}%
  \setlength{\spcoverH@sp@one}{\dimexpr\textheight-2mm\relax}%
  \begin{spcoverframe@sp@one}{%
    \begin{tcbclipinterior}
      \draw[メイン枠線, opacity=.06, line width=.7pt] (interior.center) circle (4.5cm);
    \end{tcbclipinterior}}%
    \tikz[baseline=0pt]{%
      \draw[メイン枠線, line width=1.1pt] (0,0) circle (.9cm);
      \draw[メイン枠線, line width=.6pt, dash pattern=on .5pt off 2.2pt] (0,0) circle (.62cm);
      \fill[メイン枠線] (0,0) circle (.24cm);}\\[18pt]
    {\gtfamily[6]\large\color{タイトル}#1}\\[6pt]
    {\gtfamily[5]\color{フッタ}\small#2}\\[36pt]
    {\color{フッタ}\footnotesize#3}\\[2pt]
    {\color{フッタ}\footnotesize#4}%
  \end{spcoverframe@sp@one}%
  \clearpage}

% \spMakeHoverCover{版・キッカー}{主題}{副題}{フッタ}
