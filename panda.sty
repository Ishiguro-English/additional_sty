\let\originaltextemoji\textemoji
\let\originalcoloremoji\coloremoji
\renewcommand{\textemoji}[1]{\ispace\originaltextemoji{#1}}
\renewcommand{\coloremoji}[1]{\ispace\originalcoloremoji{#1}}

% 末尾のコメントアウト必須！
\newcommand{\panda}[1]{\ispace\scalebox{1.6}{%
  \ifthenelse{\equal{#1}{default}\OR\equal{#1}{デフォルト}}{\raisebox{-.1zw}{\和文一文字画像*{\texmf/ptex/platex/tetsutex/additional_sty/画像/panda/panda_default.pdf}}}{}%
  \ifthenelse{\equal{#1}{full}\OR\equal{#1}{全身}}{\和文一文字画像*{\texmf/ptex/platex/tetsutex/additional_sty/画像/panda/panda_full.pdf}}{}%
  \ifthenelse{\equal{#1}{good}\OR\equal{#1}{いいね}}{\和文一文字画像*{\texmf/ptex/platex/tetsutex/additional_sty/画像/panda/panda_good.pdf}}{}%
}}

\newcounter{emojititlebangou}
\setcounter{emojititlebangou}{1}
\newtcolorbox{emojititlebox}[2][-5pt]{%
  enhanced,
  boxsep=0pt,left=0pt,right=0pt,top=3pt,bottom=3pt,
  frame hidden,
  opacityback=0,
  after=\br{.5},
  underlay={%
    \node[right=#1]at($(frame.north west)!.4!(frame.south west)$){\HUGE#2};
    \draw[black!60,ultra thick]([xshift=6.5zw,yshift=.3zw]frame.north west)--([xshift=-1zw,yshift=.3zw]frame.north east);
    \draw[black!60,ultra thick]([xshift=-1zw,yshift=.3zw]frame.north east)arc(90:0:1zw);
    \draw[black!60,ultra thick]([yshift=-.7zw]frame.north east)--([yshift=1zw]frame.south east);
    \draw[black!60,ultra thick]([yshift=1zw]frame.south east)arc(0:-90:1zw);
    \draw[black!60,ultra thick]([xshift=-1zw]frame.south east)--([xshift=4.5zw]frame.south west);
    \draw[black!40,ultra thick]([xshift=5.5zw]frame.north west)--([xshift=-1.3zw]frame.north east);
    \draw[black!40,ultra thick]([xshift=-1.3zw]frame.north east)arc(90:0:1zw);
    \draw[black!40,ultra thick]([xshift=-.3zw,yshift=-1zw]frame.north east)--([xshift=-.3zw,yshift=.7zw]frame.south east);
    \draw[black!40,ultra thick]([xshift=-.3zw,yshift=.7zw]frame.south east)arc(0:-90:1zw);
    \draw[black!40,ultra thick]([xshift=-1.3zw,yshift=-.3zw]frame.south east)--([xshift=4.5zw,yshift=-.3zw]frame.south west);
  }%
}

\newcommand{\emojititle}[3][-5pt]{\begin{emojititlebox}[#1]{#2}\mgfamily\Large{\HUGE\ihspace{1.8zw}}\theemojititlebangou.\ihspace{1zw}#3\end{emojititlebox}\stepcounter{emojititlebangou}}