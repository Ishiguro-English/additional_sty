\newcommand{\分数漸化式２}{\カラーポイント{分数漸化式$a_{n+1}=\bun{ra_n+s}{pa_n+q}$の一般論}{
\hfill （ただし$p\ne 0,\ rq-ps\ne 0$）

\noindent \ajKaku{1}\ihspace{1zw}$s=0$の場合

\見出しぶら下げ[1zw]{\→ }{\ihspace{1zw}\波線{両辺$0$でないことを確認した上で逆数を取る！}}

\sp

\noindent \ajKaku{2}\ihspace{1zw}$s\ne 0$の場合

\hfill （ノーヒントで入試に出題されることはまれ）

\見出しぶら下げ[1zw]{\→ }{\parindent=1zw\hspace{1zw}「$a_n=b_n+c$」とおき，
{\mathindent=1zw\[&b_{n+1}+c=\bun{r(b_n+c)+s}{p(b_n+c)+q}\\
\LLeftrightarrow{}&b_{n+1}=\bun{(r-cp)b_n+(cr+s-c^2p-cq)}{pb_n+(pc+q)}\]}
として，分子の定数項$cr+s-c^2p-cq=0$となる$c$の値を求めれば，
\[b_{n+1}=\bun{(r-cp)b_n}{pb_n+(pc+q)}\]
となり，\ajKaku{1}の場合に帰着される。}}}

