\newcommand{\２項間漸化式}{\カラーポイント{２項間漸化式$a_{n+1}=pa_n+f(n)$}{\begin{enumerate}[\Kaku{enumi}]
\item $p=1$のとき
\[a_{n+1}-a_n=f(n)\]
より，階差数列が求まる（$n=1$の場合分けに注意）。
\item $p\ne 1$のとき
\begin{enumerate}[\Kakkoalph{enumii}]
\item 一般の場合
\[g(n+1)=pg(n)+f(n)\]
を満たす多項式$g(n)$（特殊解）を見つけて，漸化式と辺々引くことで，
\[a_{n+1}-g(n+1)=p\left\{a_n-g(n)\right\}\]
となり，等比数列に帰着される。
\item $f(n)=A\cdot r^n$（等比数列）の場合は両辺$p^{n+1}$か$r^{n+1}$で割って，数列$\left\{\bun{a_n}{p^n}\right\}$か$\left\{\bun{a_n}{r^n}\right\}$の一般項を求める。
\end{enumerate}
\end{enumerate}}}

%% 同様
\newcommand{\３項間漸化式}{\カラーポイント{３項間漸化式$a_{n+2}+pa_{n+1}+a_n=0$}{
\見出しぶら下げ{Step1．}{特性方程式$x^2+px+q=0$を解いて特性解を求める}
\見出しぶら下げ{Step2．}{$\left\{\begin{array}{l}
a_{n+2}-\alpha a_{n+1}=\beta(a_{n+1}-\alpha a_n)\\
a_{n+2}-\beta a_{n+1}=\alpha(a_{n+1}-\beta a_n)
\end{array}\right.$と等比数列の形に変形する}
\見出しぶら下げ{Step3．}{等比数列を解き，辺々引く}
\見出しぶら下げ*{㊟}{特性方程式が重解をもつときはStep2．が同じ式を表すので，２項間漸化式を解く}}}

%% 同様
\newcommand{\３項間漸化式の解}{\カラーポイント{３項間漸化式の解の形}{
\begin{enumerate}[\Kaku{enumi}]
\item 特性方程式$x^2+sx+t=0$が相異なる2解をもつとき，つまり特性方程式の判別式が$0$でないとき

2解を$\alpha$，$\beta$として，$a_n$は，ある定数$u$，$v$を用いて
\[\bs{a_n=u\alpha^{n-1}+v\beta^{n-1}}\]
と表せる
\item 特性方程式$x^2+sx+t=0$が重解をもつとき，つまり特性方程式の判別式が$0$のとき

重解を$\alpha$として，$a_n$は，ある定数$u$，$v$を用いて
\[\bs{a_n=(un+v)\cdot\alpha^{n-1}}\]
と表せる
\end{enumerate}}}

