\newcommand{\関数方程式}{\カラーポイント{関数方程式}{
\begin{enumerate}[\KuroKaku{enumi}]
\item 具体的な値を代入
\begin{箇条書き}
\item 極端な値（$0,\,\pm1$など）を代入
\item 異なる文字に同じ値を代入
\item 片方の文字だけに値を代入
\end{箇条書き}
\item 微分と結びつける
\begin{enumerate}[\Kakkoalph{enumii}]
\item 微分係数/導関数の定義
\item 関数方程式の両辺をある文字について微分\par
㊟~$f(x)$が微分可能であるか確認すること
\end{enumerate}
%\item 導関数の定義に持ち込む
%\[\limh[0]\bun{f(x+h)-f(x)}{h}=f'(x)\]
%\sp
\item （整式なら）次数決定
\begin{enumerate}[\Kakkoalph{enumii}]
\item 次数を$n$として両辺を比較
\item $f(x)=a_nx^n+a_{n-1}x^{n-1}+\cdots\ (a_n\neq 0)$とおいて，$n\to n-1\to n-2$次の順に係数比較
\end{enumerate}
\end{enumerate}}}

\newcommand{\３次方程式}{\カラーポイント{$3$次方程式の解の扱い}{
3次方程式の解が$\alpha,\ \beta,\ \gamma$のとき，
\begin{enumerate}[\Kaku{enumi}]
\item 解と係数の関係
\item 解を代入して等式条件を得る
\[f(\alpha)=f(\beta)=f(\gamma)=0\]
\item 因数分解
\[f(x)=k(x-\alpha)(x-\beta)(x-\gamma)\]
\end{enumerate}}}

\newcommand{\方程式の解}{\カラーポイント{方程式の解が分かったときの対応}{
\begin{enumerate}[\Kaku{enumi}]
\item 解を代入して等式条件を得る
\item 解と係数の関係
\item 解を利用して因数分解
\end{enumerate}}}

\newcommand{\次数決定の方法}{\カラーポイント{次数決定の方法}{
\begin{enumerate}[\Kaku{enumi}]
\item 次数を$n$として両辺を比較
\item $f(x)=a_nx^n+a_{n-1}x^{n-1}+\cdots\ (a_n\neq 0)$とおいて，$n\to n-1\to n-2$次の順に係数比較
\end{enumerate}}}

\newcommand{\割り算の公式}{\カラーポイント{割り算の公式}{
整式$f(x)$を$g(x)$で割った商が$Q(x)$，余りが$R(x)$であるとき，
\[&f(x)=g(x)Q(x)+R(x)\\
&\text{（ただし}R(x)\text{は}g(x)\text{より低次）}\]
という\強調{恒等式}を実際に立てる。その後，「具体的な値を代入」「両辺微分して式の本数を増やす」などを行う。}}

\newcommand{\剰余定理・因数定理}{\カラーポイント{剰余定理・因数定理}{
○ 剰余定理

\ihspace{1zw}$f(x)$を$x-\alpha$で割った余りは$f(\alpha)$

○ 因数定理

\ihspace{1zw}\ajMaru1「$f(x)$が$x-\alpha$で割り切れる」$\同値 f(\alpha)=0$

\ihspace{1zw}\ajMaru2「$f(x)$が$(x-\alpha)^2$で割り切れる」

\hfil $\同値 f(\alpha)=f'(\alpha)=0$

\ihspace{1zw}\ajLig{○注} \ajMaru2は$f(x)$を微分して導くこと！}}

\newcommand{\因数定理}{\カラーポイント{因数定理}{
整式$f(x)$が$x-\alpha$で割り切れる条件は$f(\alpha)=0$}}

\newcommand{\因数定理の拡張}{\カラーポイント{因数定理の拡張}{
整式$f(x)=0$が$(x-\alpha)^k$で割り切れる条件は
\[f(\alpha)=f'(\alpha)=\cdots=f^{(k-1)}(\alpha)=0\]}}

\newcommand{\対称式}{\カラーポイント{対称式の扱い}{対称式は基本対称式で表す！}}

\newcommand{\３文字の交代式}{\カラーポイント{3文字の交代式}{
3文字$a,\,b,\,c$についての交代式は
\[(b-c)(c-a)(a-b)\]
を因数に持つ}}

\newcommand{\対称式と交代式}{\カラーポイント{対称式と交代式}{
\[&\text{(対称式)$\times$(対称式)$=$(対称式)}\\
&\text{(対称式)$\times$(交代式)$=$(交代式)}\\
&\text{(交代式)$\times$(交代式)$=$(対称式)}\]

\ajLig{○注} 対称式は$1$，交代式は$-1$に相当するとイメージすると分かりやすい}}

\newcommand{\実数係数の方程式}{\カラーポイント{実数係数の方程式の複素数解}{
実数係数の方程式
\[a_nz^n+a_{n-1}z^{n-1}+\cdots a_1z+a_0=0\]
について
\begin{enumerate}[\Kaku{enumi}]
\item 複素数$\alpha$を解にもつとき，$\conj{\alpha}$を解に持つ
\item 奇数次のとき，実数解を少なくとも１つ持つ
\end{enumerate}}}

\newcommand{\次数下げ}{\カラーポイント{次数下げの方法}{
\begin{enumerate}[\Kaku{enumi}]
\item $\alpha^n$を$(n-1)$次以下の$\alpha$の式で表す\\
\→ 計算は楽だが，1度に1次ずつしか下がらないので，低次の場合に向いている
\item 割り算の公式の利用\\
\→ 一気に次数が下がるが，計算が面倒なので，高次の場合に向いている
\end{enumerate}}}

