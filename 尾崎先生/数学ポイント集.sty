%\newcommand{\微積分学の基本定理２}{\カラーポイント{微積分学の基本定理}{
%$f(x)$の原始関数を$F(x)$とすると，
%\[&\bun{\d}{\dx}\int^{g(x)}_{h(x)}f(t)\dt\\
%=&\bun{\d}{\dx}\Bigl[F(x)\Bigr]^{g(x)}_{h(x)}\\
%=&\bun{\d}{\dx}\left\{F\left(g(x)\right)-F\left(h(x)\right)\right\}\\
%=&f\left(g(x)\right)\cdot g'(x)-f\left(h(x)\right)\cdot h'(x)\]}}

