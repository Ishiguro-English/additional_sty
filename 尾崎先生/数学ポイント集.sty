\newcommand{\ペアにして考える}{\カラーポイント{$a+b\sq{X}$を見たら…}{
$a-b\sq{X}$とセットで考える。
\[\left(a+b\sq{X}\right)^n&=A_n+B_n\sq{X}\\
\left(a-b\sq{X}\right)^n&=A_n-B_n\sq{X}\]
が成り立つので，
\[\left(a+b\sq{X}\right)^n+\left(a-b\sq{X}\right)^n=2A_n\]
と表せる。$\left|a-b\sq{X}\right|<1$であれば上の式と合わせて整数部分の偶奇が分かる。}}

\newcommand{\二項定理}{\カラーポイント{二項定理}{
$n$を自然数とするとき，
\[(a+b)^n=\sum^n_{k=0}\c{n}{k}a^kb^{n-k}=\sum^n_{k=0}\c{n}{k}a^{n-k}b^k\]}}

\newcommand{\有名な漸化式}{\カラーポイント{$\alpha^n+\beta^n$の形を見たら…}{
\[\alpha^{n+2}+\beta^{n+2}=\left(\alpha+\beta\right)\left(\alpha^{n+1}+\beta^{n+1}\right)\freqn{\bs{-\alpha\beta\left(\alpha^n+\beta^n\right)}}\]
という漸化式を浮かべる}}

\newcommand{\合同式の定義}{\カラーポイント{合同式の定義}{%
$m$をある整数とする。整数$a,\ b$について，$a-b$が$m$の倍数であるとき，「$a,\ b$は$m$を法として合同である」と言い，\[a\合同 bm\]
と表す}}

\newcommand{\合同式の演算}{\カラーポイント{合同式の演算}{%
$m,\ a,\ b,\ c,\ d\in\Z$として，合同式の法を$m$とすると，
\begin{enumerate}[\Maru{enumi}]
\item $a\equiv  b\Rightarrow b\equiv  a$
\item $a\equiv b,\ b\equiv  c\Rightarrow a\equiv  c$
\br{.5}
\item $a\equiv b,\ c\equiv d
\Rightarrow \left\{\begin{array}{clc}
a+c&\equiv& b+d\\
a-c&\equiv& b-d\\
ac&\equiv& bd\\
a^n&\equiv& b^n
\end{array}\right.$
\item $\left\{\begin{array}{l}
ka\equiv kb\\
\text{$k$と$m$は互いに素}
\end{array}\right.
\Rightarrow a\equiv b$
\end{enumerate}}}

