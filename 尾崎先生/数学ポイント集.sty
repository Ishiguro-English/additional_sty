\newcommand{\数列の極限}{\カラーポイント{「$a_{n+1}=f(a_n)$」型の問題}{\mathindent=1.5zw
\noindent 【目標】$\limn a_n$を求める
\spp
\見出しぶら下げ{Step1．}{極限値を予想する

\→ $\alpha=f(\alpha)$を満たす$\alpha$を数式かグラフで求める}
\見出しぶら下げ{Step2．}{$a_{n+1}=f(a_n)$の両辺から$\alpha=f(\alpha)$を引く
\[a_{n+1}-\alpha=f(a_n)-f(\alpha)\]}
\見出しぶら下げ{Step3．}{$f(a_n)-f(\alpha)$から$a_n-\alpha$をくくりだす
\begin{enumerate}[\Maru{enumi}]
\item 整式　　：因数分解
\item 無理関数：有理化
\item 分数関数：通分
\item 一般の関数 or \ajMaru1〜\ajMaru3が無理な場合\\
：\bgt{平均値の定理}
\end{enumerate}
}
\見出しぶら下げ{Step4．}{$a_n-\alpha$の正負が分からないときは両辺絶対値を取る
\[|a_{n+1}-\alpha|=|●||a_n-\alpha|\]}
\見出しぶら下げ{Step5．}{$|●|$を\波線{$0\leqq r<1$}を満たす\bgt{定数}で上から評価し，以下の不等式を作る
\[|a_{n+1}-\alpha|\leqq r|a_n-\alpha|\text{　……☆}\]

\ajLig{○注} \bgt{$a_n$の大きさの評価}が必要なことがある}
\見出しぶら下げ{Step6．}{☆をくり返し用いる
\[(0\leqq )\ |a_n-\alpha|\leqq r^{n-1}|a_1-\alpha|\]}
\見出しぶら下げ{Step7．}{$n\to \infty$で「はさみうちの原理」を使う
\[\limn|a_n-\alpha|=0\同値 \limn a_n=\alpha\]}}}

