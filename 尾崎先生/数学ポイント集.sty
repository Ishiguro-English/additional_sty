\newcommand{\三角不等式}{\カラーポイント{三角不等式}{
複素数$\alpha$，$\beta$に対して，
\[\bigl||\alpha|-|\beta|\bigr|\leqq |\alpha+ \beta|\leqq |\alpha|+|\beta|\]

等号成立条件は

\見出しぶら下げ{左側：}{$\arg\alpha=\arg\beta+\pi$（$\vec{0\alpha}$と$\vec{0\beta}$が“逆向きに平行”）}

\見出しぶら下げ{右側：}{$\arg\alpha=\arg\beta$（$\vec{0\alpha}$と$\vec{0\beta}$が“同じ向きに平行”）}}}

\newcommand{\三角不等式２}{\カラーポイント{三角不等式（$n$文字）}{
登場する文字は全て複素数とする
\[\ihspace{-1zw}|\alpha_1\pm \alpha_2\pm \cdots \pm \alpha_n|\leqq |\alpha_1|+|\alpha_2|+\cdots+|\alpha_n|\]

「絶対値を分けると大きくなる」というイメージを持つ}}

\newcommand{\三角不等式３}{\カラーポイント{三角不等式}{
実数$x,\ y$に対して，
\[\left||x|-|y|\right|\leqq |x+y|\leqq |x|+|y|\]

（等号成立条件は左側が$xy\leqq 0$，右側が$xy\geqq 0$）}}

\newcommand{\sin等差数列の和}{\カラーポイント{$\dsum\cos{\text{（等差数列）}},\,\dsum\sin{\text{（等差数列）}}$の計算法}{\raggedright
\begin{enumerate}[\Kaku{enumi}]
