\newcommand{\二次曲線の接線}{\カラーポイント{二次曲線の接線（標準形）}{二次曲線上の点$(x_0,\,y_0)$における接線は
\begin{enumerate}[\Kaku{enumi}]
\item 楕円$\bun{x^2}{a^2}+\bun{y^2}{b^2}=1$について
\[\bun{x_0x}{a^2}+\bun{y_0y}{b^2}=1\]
\item 双曲線$\bun{x^2}{a^2}-\bun{y^2}{b^2}=1$について
\[\bun{x_0x}{a^2}-\bun{y_0y}{b^2}=1\]
\item 放物線$y^2=4px$について
\[y_0y=2p(x+x_0)\]
\end{enumerate}}}

\newcommand{\二次曲線の接線２}{
\カラーポイント{二次曲線の接線（一般形）}{
二次曲線上の点$(x_0,\,y_0)$における接線は
\bgroup
\addtolength{\mathindent}{-2zw}
\begin{enumerate}[\Kaku{enumi}]
\item 楕円$\bun{(x-m)^2}{a^2}+\bun{(y-n)^2}{b^2}=1$について
\begin{align*}
\text{\scalebox{0.9}[1]{$\bun{(x_0-m)(x-m)}{a^2}+\bun{(y_0-n)(y-n)}{b^2}=1$}}
\end{align*}
\item 双曲線$\bun{(x-m)^2}{a^2}-\bun{(y-n)^2}{b^2}=1$について
\begin{align*}
\text{\scalebox{0.9}[1]{$\bun{(x_0-m)(x-m)}{a^2}-\bun{(y_0-n)(y-n)}{b^2}=1$}}
\end{align*}
\item 放物線$(y-n)^2=4p(x-m)$について
\begin{align*}
\text{\scalebox{0.9}[1]{$(y_0-n)(y-n)=2p\{(x-m)+(x_0-m)\}$}}
\end{align*}
\end{enumerate}
\egroup}}

\newcommand{\双曲線の漸近線}{\カラーポイント{双曲線の漸近線の求め方}
{$b^2(x^2-2mx+m^2)-a^2(y^2-2ny+n^2)=a^2b^2$の\\
漸近線を求めるときは，
\見出しぶら下げ{Step1．}{\bgt{平方完成}
\[\bun{(x-m)^2}{a^2}-\bun{(y-n)^2}{b^2}=1\]}
\見出しぶら下げ{Step2．}{\bgt{「$=1$」を「$=0$」に}

無限に伸ばしていくと，ほぼ一致する直線なので，
\[\bun{(x-m)^2}{a^2}-\bun{(y-n)^2}{b^2}=0\]}
\見出しぶら下げ{Step3．}{\bgt{因数分解}
\[&\ihspace{-5zw}\Bigl(\bun{x-m}{a}+\bun{y-n}b\Bigr)\Bigl(\bun{x-m}{a}-\bun{y-n}b\Bigr)=0\\
\ihspace{-5zw}\同値 &\bun{y-n}b=\pm \bun{x-m}{a}\]}}}

