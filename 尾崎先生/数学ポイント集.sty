\newcommand{\アステロイドと放物線}{\カラーポイント{$x^k+y^k=a^k$で表される曲線とパラメータ表示}{%タイトル付けるの厳しい（笑）
\begin{enumerate}[\Kaku{enumi}]
\item $k=2$のとき：円
\[x^2+y^2=a^2,\ (x=a\cos\theta,\ y=a\sin\theta)\]
\item $k=1$のとき：直線
\[x+y=a,\ (x=a\cos^2\theta,\ y=a\sin^2\theta)\]
\item $k=\bun23$のとき：アステロイド
\[x^{\bun23}+y^{\bun23}=a^{\bun23},\ (x=a\cos^3\theta,\ y=a\sin^3\theta)\]
\item $k=\bun12$のとき：放物線
\[x^{\bun12}+y^{\bun12}=a^{\bun12},\ (x=a\cos^4\theta,\ y=a\sin^4\theta)\]
\end{enumerate}
}}

