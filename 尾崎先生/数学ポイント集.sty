\newcommand{\微分係数の定義}{\カラーポイント{微分係数の定義}{関数$f(x)$に対し，極限値$\limh[0]\bun{f(a+h)-f(a)}h$が存在するとき，$f(x)$は$x=a$において\強調{微分可能}であると言い，その極限値を$\bs{f'(a)}$と表す。

$a+h=b$とおけば，この極限値は$\limb[a]\bun{f(b)-f(a)}{b-a}$とも表せる。}}

\newcommand{\微分係数の定義の着眼と発想}{\カラーポイント{微分係数の定義}{「$f(b)-f(a)$」の形をした「$\bun00$」の不定形の解消に役立つ。$f$は抽象的な関数でも良い。次の式変形が要求されることが多い。
\begin{箇条書き}
\item 分母・分子を$b-a$で割る
\item 同じものを足し引きして分割する
\end{箇条書き}}}

\newcommand{\接線の本数を数える問題}{\カラーポイント{接線の本数を数える問題}{接線と接点の個数が一致することをコメントする

\見出しぶら下げ*{㊟}{接線と接点の個数の一致が自明でない関数はグラフを描いて考える（誘導が付くことも多い）}}}

\newcommand{\法線の本数を数える問題}{\カラーポイント{法線の本数を数える問題}{法線と接点の個数が一致することをコメントする

\見出しぶら下げ*{㊟}{法線と接点の個数の一致が自明でない関数はグラフを描いて考える（誘導が付くことも多い）}}}

\newcommand{\グラフの描き方}{\カラーポイント{グラフの描き方}{
\begin{enumerate}[\Kaku{enumi}]
\item 定義域チェック

\ajMaru1 \bgt{分母$\ne0$}，\ajMaru2 \bgt{真数条件}，\ajMaru3 \bgt{ルートの中身$0$以上}
\item 対称性/周期性チェック（手間が減る）
\見出しぶら下げ*{㊟}{三角関数のときは特に}
\item 微分→増減表
\item 極限チェック

\ajMaru1 両端（端点，無限遠点），\ajMaru2 不連続点 $x\to \alpha\pm 0$
\item グラフを描く
\end{enumerate}}}

\newcommand{\共通接線}{\カラーポイント{共通接線の求め方}{
\begin{enumerate}[\Kaku{enumi}]
\item \下線{$g(x)$が2次関数のとき}
\見出しぶら下げ*{\→}{$y=f(x)$上の接点を設定し，そこでの接線が$y=g(x)$と接する条件を考える}
\item \下線{$f(x),\,g(x)$ともに2次関数でないとき}
\見出しぶら下げ*{\→}{$y=f(x)$，$y=g(x)$上のそれぞれの接点を設定し，それぞれの点における接線が一致する条件を考える（1次係数と定数項を比較する）}
%\item 共通接線を設定し，これが両曲線に接する（重解条件を2回使う）
\end{enumerate}}}

\newcommand{\共通接線１}{\カラーポイント{\ajKuroKaku1 \bgt{接点を２つ設定する}}{
\見出しぶら下げ{Step1．}{$(s,\ f(s))$における$y=f(x)$の接線と$(t,\ g(t))$における$y=g(x)$の接線を立式する
\[\left\{\begin{array}{ll}
y=f'(s)(x-s)+f(s)\\
y=g'(t)(x-t)+g(t)
\end{array}\right.\]}
\見出しぶら下げ{Step2．}{2本の接線が一致する条件を求める}}}

\newcommand{\共通接線２}{\カラーポイント{\ajKuroKaku2 \bgt{接点を１つ設定する}}{
\見出しぶら下げ{Step1．}{$(t,\ f(t))$における$y=f(x)$の接線を立式する
\[y=f'(t)(x-t)+f(t)\]}
\見出しぶら下げ{Step2．}{上の式と$y=g(x)$から$y$消去した式が重解を持つ条件を求める}}}

\newcommand{\汚い値}{\カラーポイント{汚い値や求まらない値}{一旦文字で置いて最後に値・関係式を代入せよ}}

\newcommand{\面積計算の工夫}{\カラーポイント{面積計算の工夫}{
三角形，四角形，扇形，$\bun16$公式が使える形に図形を分割

して，計算を軽減する}}

\newcommand{\対数の積分}{\カラーポイント{$\log$の積分}{
不定積分を$C$とすると，
\sp
\begin{enumerate}[\Kaku{enumi}]
\item $\int \log x\dx=x\log x-x+C$
\item $\int \log (x+a)\dx=(x+a)\log (x+a)-x+C$
\end{enumerate}}}

