\newcommand{\三角関数２}{\カラーポイント{三角関数の応用手法}{
\begin{enumerate}[\KuroKaku{enumi}]
\item \強調{$\sin \theta,\ \cos \theta$の対称式}

$t=\sin\theta+\cos\theta$と置くと，$\sin\theta\cos\theta=\bun{t^2-1}2$と表せるので，$t$の関数に。$t$の変域に注意！
\item \強調{$X=\cos \theta,\ Y=\sin \theta$と置いて図示}

図形が$X^2+Y^2=1$と共有点を持つ条件を考える。
%\item \強調{$\sin =\sin,\ \cos =\cos$の形}%%絶対に載せない！
%
%左辺に寄せて和積でも良いが，角度を直接比較することもできる。
\item \強調{次数下げ}

半角，積和は，三角関数の次数を下げることができる。
\[&\cos^2 \theta=\bun{1+\cos 2\theta}2,\quad\sin^2 \theta=\bun{1-\cos 2\theta}2\\
&\sin\theta\cos\theta=\bun12\sin2\theta\]

%\ajLig{○注} $\sin \theta$と$\cos \theta$の$2$次同次式なら，$\sin2\theta,\ \cos2\theta$の$1$次式に落とし込めるので，合成を使って最大・最小が求まる。
\sp
\item \強調{\raisebox{6pt}{$t=\tan\bun{\theta}2$の置換}}
\[\left\{\begin{array}{ll}
\cos \theta=\bun{1-t^2}{1+t^2},\quad \sin\theta=\bun{2t}{1+t^2}\\[10pt]
\tan \theta=\bun{2t}{1-t^2}
\end{array}\right.\]

\ajLig{○注} 最終奥義。分数かつ次数も上がるので避けたい。
\end{enumerate}}}

