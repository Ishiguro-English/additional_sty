\newcommand{\パラメータ分離}{\カラーポイント{パラメータを含む方程式・不等式}{
\begin{enumerate}[\KuroKaku{enumi}]
\item 完全パラメータ分離\\
\→ $a=(x\text{のみの式})$の形に変形
\item 不完全パラメータ分離\\
\→ $(\text{$a$を含む$x$の一次式})=(\text{$x$のみの式})$の形に変形
\item パラメータを分離しない
\begin{enumerate}[\Kakkoalph{enumii}]
\item ２次方程式なら「解の配置」
\item 差を取って増減や値域を調べる
\end{enumerate}
\end{enumerate}}}

\newcommand{\不完全パラメータ分離}{\カラーポイント{不完全パラメータ分離}{
グラフを利用することが目的なので，
\[(\text{$a$を含む$x$の一次式})=(\text{$x$のみの式})\]
の左辺が\bgt{定点を通り，$a$について同次である}ときに使う}}

\newcommand{\平行移動}{\カラーポイント{平行移動}{$y=f(x)$のグラフを$x$軸方向に$p$，$y$軸方向に$q$平行移動したグラフの方程式は
\[y-q=f(x-p)\同値 y=f(x-p)+q\]}}

\newcommand{\拡大}{\カラーポイント{拡大}{$y=f(x)$のグラフを$x$軸方向に$a$倍，$y$軸方向に$b$倍拡大したグラフの方程式は
\[\bun yb=f\left(\bun xa\right)\同値 y=bf\left(\bun xa\right)\]}}

\newcommand{\対称移動}{\カラーポイント{対称移動}{$y=f(x)$のグラフを…
\begin{enumerate}[\Kaku{enumi}]
\item $x$軸に関して対称移動したグラフの方程式は
\[-y=f(x)\同値 y=-f(x)\]
\item $y$軸に関して対称移動したグラフの方程式は
\[y=f(-x)\]
\item 原点に関して対称移動したグラフの方程式は
\[-y=f(-x)\同値 y=-f(-x)\]
\item $y=x$に関して対称移動したグラフの方程式は
\[x=f(y)\]
\end{enumerate}}}

\newcommand{\折返し}{\カラーポイント{折返し}{$y=f(x)$のグラフを…
\begin{enumerate}[\Kaku{enumi}]
\item $x=p$に関して折り返したグラフの方程式は
\[y=f(2p-x)\]
\item $y=q$に関して折り返したグラフの方程式は
\[2q-y=f(x)\同値 y=-f(x)+2q\]
\item $(p,\,q)$に関して折り返したグラフの方程式は
\[\ihspace{-2zw}2q-y=f(2p-x)\同値 y=-f(2p-x)+2q\]
\item $y=x$に関して折り返したグラフの方程式は
\[x=f(y)\ihspace{1zw}\text{($x,\ y$を入れ替える)}\]
\end{enumerate}}}

\newcommand{\変換と軌跡}{\カラーポイント{変換による軌跡の方程式の求め方}{
\見出しぶら下げ{Step1．}{変換前の曲線上の点をP\ $(x,\ y)$，変換後の曲線上の点をQ\ $(X,\ Y)$と置く}
\見出しぶら下げ{Step2．}{式を２本立式し，点Q\ $(X,\ Y)$が点P\ $(x,\ y)$に移動したと読みかえて，
\[\left\{\begin{array}{ll}
x=\ovalbox{$X,\ Y$の式}\\
y=\ovalbox{$X,\ Y$の式}
\end{array}\right.\text{　……☆}\]の形で表す}
\見出しぶら下げ{Step3．}{元の曲線の方程式（$x,\ y$の式）に☆を代入する}
\見出しぶら下げ{Step4．}{$X,\ Y$を$x,\ y$に書き換えて，答えを表す}}}

\newcommand{\偶関数・奇関数}{\カラーポイント{偶関数・奇関数}{
\begin{enumerate}[\Kaku{enumi}]
\item 任意の実数$x$に対して，\下線{$f(x)=f(-x)$}\\
\→ $f(x)$は偶関数であり，$y$軸対称
\item 任意の実数$x$に対して，\下線{$f(x)=-f(-x)$}\\
\→ $f(x)$は奇関数であり，原点対称
\end{enumerate}}}

\newcommand{\偶関数・奇関数と定積分}{
\begin{enumerate}[\Kaku{enumi}]
\item $f(x)$が偶関数
\[\int^a_{-a}f(x)\dx=2\int^a_0f(x)\dx\]
\item $f(x)$が奇関数
\[\int^a_{-a}f(x)\dx=0\]
\end{enumerate}}

\newcommand{\周期関数}{\カラーポイント{周期関数}{
関数$f(x)$が任意の実数$x$に対して，\下線{$f(x)=f(x+c)$}を満たすとき，$f(x)$を周期$c$の周期関数といい，正の数$c$のうち最小のものを基本周期という}}

\newcommand{\関数方程式の代入の候補例}{\カラーポイント{関数方程式の代入の候補例}{
\begin{箇条書き}
\item $x=0,\ y=0$（$f(0)$を知りたいとき）
\item $x=1,\ y=1$（$f(1)$を知りたいとき）
\item $x=x,\ y=0$（$0$は何を足しても不変）
\item $x=x,\ y=1$（$1$は何を掛けても不変）
\item $x=x,\ y=-x$（足して，$0$を作る）
\item $x=x,\ y=\bun1x$（掛けて，$1$を作る）
\item $x=x,\ y=x+h$（$h\to 0$で微分の定義式へ）
\end{箇条書き}}}

