\newcommand{\数列の和の積分の誘導}{\カラーポイント{$\int^●_●\fbox{数列の和}\dx$の問題のパターン}{
\begin{enumerate}[\Kaku{enumi}]
\item 「$\sum\txt{表記したもの}=\sum\txt{計算したもの}$」と整理する
\[\sum^n_{k=1}(-1)^{k-1}x^{2k-2}=\bun1{1+x^2}-\bun{(-x^2)^n}{1+x^2}\]
%\bun{1-(-x^2)^n}{1+x^2}\]
%\bun1{1+x^2}-\bun{(-x^2)^n}{1+x^2}\]
\item 両辺を積分すると，左辺に第$n$部分和が表れ，右辺の$n$を含まない項は定積分を計算できる
\[\sum^n_{k=1}\bun{(-1)^{k-1}}{2k-1}=\bun{\pi}4-\int^1_0\bun{(-x^2)^n}{1+x^2}\dx\]
\item \ajKaku2の右辺の$n$を含む項は被積分関数を不等式で評価し，$n\to \infty$とすれば，はさみうちの原理により$0$に収束することが示される
\[\limn \int^1_0\bun{(-x^2)^n}{1+x^2}\dx=0\]
\item \ajKaku2において$n\to \infty$とすると，無限級数が求まる
\[\sum^{\infty}_{k=1}\bun{(-1)^{k-1}}{2k-1}=\bun{\pi}4\]
\item[※]$n$を含む定積分について整理しても良い
\[\scalebox{.9}{$\left|\sum^n_{k=1}\bun{(-1)^{k-1}}{2k-1}-\bun{\pi}4\right|=\left|(-1)^{n+1}\int^1_0\bun{x^{2n}}{1+x^2}\dx\right|$}\]
\end{enumerate}
}}

