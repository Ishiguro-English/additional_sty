\newcommand{\接線の方程式}{\カラーポイント{接線の方程式}{
曲線$y=f(x)$上の点$(t,\,f(t))$における接線は，
\[y=f'(t)(x-t)+f(t)\]}}

\newcommand{\法線の方程式}{\カラーポイント{法線の方程式}{

曲線$y=f(x)$上の点$(t,\,f(t))$における法線は，
\begin{enumerate}[\textbullet]
\item $f'(t)=0$のとき：$x=t$
\item $f'(t)\ne 0$のとき：$y=-\bun{1}{f'(t)}(x-t)+f(t)$
\end{enumerate}
\見出しぶら下げ*{\→}{２つをまとめて，
\[(x-t)+f'(t)(y-f(t))=0\]

（\text{点}$(t,\,f(t))$\text{を通り，法線ベクトル}$(1,\,f'(t))$\text{の直線}）}}}

\newcommand{\点の極限}{\カラーポイント{点の極限}{点の極限\ihspace{1zw}\→\ihspace{1zw}各座標の極限を考える}}

\newcommand{\接線の解法}{\カラーポイント{接線の解法}{\begin{enumerate}[\Kaku{enumi}]
\item 接点を最初に設定
\item 接線を最初に設定
\begin{enumerate}[\Kakkoalph{enumii}]
\item 重解条件：準円，4次関数に2度接する場合
\item 点と直線の距離の公式：円
\end{enumerate}
\end{enumerate}
㊟~ファーストチョイスは\ajKaku1（接点より始めよ）

㊟~二次曲線の場合，\ajKaku2を使うことも}}

\newcommand{\パラメータ曲線の接線・法線}{\カラーポイント{パラメータ表示曲線の接線・法線}{
曲線$C$が$\left(x(t),\,y(t)\right)$とパラメータ表示されているとき，$t=t_0$における
\begin{enumerate}[\textbullet]
\item 接線の方程式
\[y'(t_0)(x-x(t_0))-x'(t_0)(y-y(t_0))=0\]
\item 法線の方程式
\[x'(t_0)(x-x(t_0))+y'(t_0)(y-y(t_0))=0\]
\end{enumerate}}}

\newcommand{\関数の差の形}{\カラーポイント{$f(b)-f(a)$を見たら}{\begin{enumerate}[\Kaku{enumi}]
\item （整式なら）因数定理より，$b-a$をくくりだす
\item （$\lim$なら）$b-a$で割って，微分係数の定義
\[\limb[a]\bun{f(b)-f(a)}{b-a}\]
\item 平均値の定理より，$b-a$をくくりだす
\[f(b)-f(a)=f'(c)(b-a)\]
\end{enumerate}}}

