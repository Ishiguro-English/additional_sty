\newcommand{\ジューコフスキー変換}{\カラーポイント{ジューコフスキー変換}{正の実数$a$に対して，
\[w=z+\bun{a^2}z\]と表される変換を\強調{ジューコフスキー変換}という
\begin{enumerate}[\Kaku{enumi}]
\item $|z|=a$のとき\\
2点$-2a,\,2a$を結ぶ線分に移る
\sp
\item $|z|=r_0\,(>a)$のとき\\
楕円$\bun{x^2}{\Bigl(r_0+\bun{a^2}{r_0}\Bigr)^2}+\bun{y^2}{\Bigl(r_0-\bun{a^2}{r_0}\Bigr)^2}=1$に移る
\sp
\item $\arg z=\theta_0\,\Bigl(0<\theta_0<\bun{\pi}2\Bigr)$のとき\\
双曲線$\bun{x^2}{(2a\cos\theta_0)^2}-\bun{y^2}{(2a\sin\theta_0)^2}=1$\\
\hfill $(y>-(\tan \theta_0)x)$に移る
\end{enumerate}}}

