\[S=\int_{x_\beta}^{x_\gamma}y_+\dx-\int_{x_\beta}^{x_\alpha}y_-\dx\]
\見出しぶら下げ{Step3．}{パラメータ表示$(x,\,y)=(x(t),\,y(t))$を用いて，置換積分をする}
\[S=\int_\beta^\gamma y(t)\bun{\d x(t)}{\dt}\dt-\int_\beta^\alpha y(t)\bun{\d x(t)}{\dt}\dt\]}}

%%% 引き返しなし
\newcommand{\パラメータ積分２}{\カラーポイント{パラメータ表示された曲線で囲まれた領域の面積}{\見出しぶら下げ{Step1．}{$\bun{dx}{dt},\,\bun{dy}{dt}$を求めて曲線のグラフを描く}
\見出しぶら下げ{Step2．}{$x,\ y$だけで立式する
\[S=\int^b_a y\dx\]}
\見出しぶら下げ{Step3．}{パラメータ表示$(x,\,y)=(x(t),\,y(t))$を用いて，置換積分をする
\[S=\int_{t_0}^{t_1}y(t)\bun{\dx(t)}{\dt}\dt\]}}}

\newcommand{\途中で引き返す曲線}{\カラーポイント{「途中で引き返す」曲線の囲む部分の面積}{\begin{enumerate}
