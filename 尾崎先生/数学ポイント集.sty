\newcommand{\平面の方程式}{\カラーポイント{平面のベクトル方程式}{
通る$1$点$\caprm A$（$\vec{a}$）が与えられたとして，\begin{enumerate}[\Kaku{enumi}]
\item 方向ベクトル$\vec{l},\,\vec{m}$が既知の場合
\[\vec{x}=\vec{a}+\alpha\vec{l}+\beta\vec{m}\]
\item 法線ベクトル$\vec{n}$が既知の場合
\[\raisedbigl(\vec{x}-\vec{a}\raisedbigr)\cdot\vec{n}=0\]
\end{enumerate}}}

\newcommand{\平面の方程式１}{\カラーポイント{平面のベクトル方程式\ajMaru1}{
点{A}（$\vec{a}$）を通り，$\vec{l}$と$\vec{m}$によって張られる平面のベクトル方程式は$s,\ t$をパラメータとして，
\[\vec{x}=\vec{a}+s\vec{l}+t\vec{m}\]}}

\newcommand{\平面の方程式２}{\カラーポイント{平面のベクトル方程式\ajMaru2}{
点{A}（$\vec{a}$）を通り，法線ベクトルが$\vec{n}$である平面のベクトル方程式は
\[\left(\vec{x}-\vec{a}\right)\cdot \vec{n}=0\]}}

\newcommand{\外積}{\カラーポイント{外積の定義}{\sp $2$つのベクトル$\vec{a}=\mat{x_1,y_1,z_1},\ \vec{b}=\mat{x_2,y_2,z_2}$に対して，
\[\vec{a}\times\vec{b}=\mat{y_1z_2-y_2z_1,z_1x_2-z_2x_1,x_1y_2-x_2y_1}\]
を$\vec{a}$と$\vec{b}$の外積（ベクトル積）という。このベクトルは$\vec{a}$と$\vec{b}$の両方に垂直となる。}}

\newcommand{\外積の性質}{\カラーポイント{外積の性質}{
\begin{enumerate}[\Kaku{enumi}]
