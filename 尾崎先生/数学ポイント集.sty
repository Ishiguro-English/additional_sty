\newcommand{\二次曲線の定義}{\カラーポイント{二次曲線の幾何的定義}{
\begin{enumerate}[\Kaku{enumi}]
\item 放物線：定点とこの点を通らない定直線からの距離が等しい点の軌跡
\item 楕円：２定点からの距離の和が一定な点の軌跡
\item 双曲線：２定点からの距離の差が一定な点の軌跡
\end{enumerate}}}

\newcommand{\二次曲線の判別法}{\カラーポイント{二次曲線の判別法}{
$ax^2+bxy+cy^2+dx+ey+f=0$が二次曲線のとき，
\begin{enumerate}[\textbullet]
\item $b^2-4ac<0$：楕円
\item $b^2-4ac=0$：放物線
\item $b^2-4ac>0$：双曲線
\end{enumerate}}}

