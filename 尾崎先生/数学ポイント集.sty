\newcommand{\極値}{
\カラーポイント{微分可能な関数が極値を持つための十分条件}{
関数$f(x)$が微分可能で，$x=a$の前後で$f'(x)$の符号が$+$から$-$に（$-$から$+$に）変化するならば，$f(x)$は$x=a$で極大値（極小値）を取る
\img[c]{3-1-02.pdf}}}

\newcommand{\極値２}{\カラーポイント{極大値・極小値の定義}
{関数$f(x)$と$x=a$に対して，$x=a$を含む十分狭い区間において$f(x)$が$x=a$で最大値（最小値）を取るとき，関数$f(x)$は$x=a$で\強調{極大値}（\強調{極小値}）を取ると言う。また，極大値と極小値をまとめて\強調{極値}という。}}

\newcommand{\分数関数の極値}{\カラーポイント{分数関数の極値の計算の工夫}{分数関数$\bun{g(x)}{f(x)}$が$x=\alpha$で極値をとるとき，$f'(\alpha)\ne0$ならば，
\[\bun{g(\alpha)}{f(\alpha)}=\bun{g'(\alpha)}{f'(\alpha)}\]}}

\newcommand{\凹凸}{\カラーポイント{凹凸の定義}{
ある区間上で定義された関数$f(x)$が\強調{上に凸}（\強調{下に凸}）であるとは，その区間に含まれる任意の2実数$a$，$b$に対して，2点$(a,\,f(a))$，$(b,\,f(b))$を結ぶ線分が$y=f(x)$のグラフよりも下（上）であることを言う
\img[c]{3-2-01.pdf}}}

\newcommand{\凹凸２}{\カラーポイント{$f''(x)$の正負と$f(x)$の凹凸の関係}{ある区間$I$上で定義された関数$f(x)$が2回微分可能であるとき，

\begin{tabular}{l@{\hspace{.8zw}}c@{\hspace{.8zw}}l}
$I$上で$f''(x)>0$&$\Rightarrow$&$f(x)$は$I$上で下に凸\\
$I$上で$f''(x)<0$&$\Rightarrow$&$f(x)$は$I$上で上に凸\\
\end{tabular}}}

\newcommand{\関数の凹凸と変曲点}{\カラーポイント{２階微分可能な関数における凹凸と変曲点}{
ある区間$I$上で定義された関数$f(x)$が2回微分可能であるとき，

\begin{tabular}{l@{\hspace{.8zw}}c@{\hspace{.8zw}}l}
$I$上で$f''(x)>0$&$\Rightarrow$&$f(x)$は$I$上で下に凸\\
$I$上で$f''(x)<0$&$\Rightarrow$&$f(x)$は$I$上で上に凸\\
\end{tabular}
\spp
\img[c]{3-2-02.pdf}

\scalebox{.8}[1]{\mbox{$f''(x)<0\ \Rightarrow f'(x)$が単調減少$\Rightarrow$接線の傾きが減少$\Rightarrow$上に凸}}

\scalebox{.8}[1]{\mbox{$f''(x)>0\ \Rightarrow f'(x)$が単調増加$\Rightarrow$接線の傾きが増加$\Rightarrow$下に凸}}
\spp
$f''(x)$の符号が$+$から$-$に（$-$から$+$に）変化する点を変曲点と言う}}

\newcommand{\振動関数}{\カラーポイント{微分しなくても概形がわかるグラフ}{\[y=f(x)\cdot (\sin ax\ {\rm{or}} \cos ax) \]
のグラフは微分しなくても概形を描くことができる。\強調{これは面積や体積を求めるときに活用できる}。しかし，\波線強調{極値は微分しないと求めることができない}。}}

\newcommand{\対称移動２}{\カラーポイント{対称移動}{
\[f(2l-x)=f(x)\]
が成立するとき，$y=f(x)$は$x=l$について対称である}}

\newcommand{\置換した関数と微分}{\カラーポイント{置き換えて良いケース／ダメなケース}{
$f\left(g(x)\right)$において，$t=g(x)$と置換して$f(t)$を考える
\sp
\begin{enumerate}[\Kaku{enumi}]
\item \下線{縦軸の値だけが問題のもの（最大値・最小値，値域）}

「置換→微分」で最大値・最小値，値域は求まる

\ajLig{○注}~$x$と$t$の関係を考える必要はない
\sp
\item \下線{グラフ上の動きが問題のもの（増減，凹凸）}

原則として，置換せずに微分

\ajLig{○注}~$g(x)$が単調なら「置換→微分」で増減は求まる

\ihspace{1.2zw}$t$ではなく，$x$を起点に考えること

\ajLig{○注}「置換→２階微分」では凹凸は求まらない
\end{enumerate}}}

\newcommand{\導関数の正負の調べ方２}{\カラーポイント{$\log$を含んだ導関数の正負の調べ方}{\noindent 【目標】$F(x)=f(x)\log x+g(x)$の正負を調べたい
\sp
\見出しぶら下げ{Step1．}{$\log$にかかっている$f(x)$を強引に括りだす}
\sp
\見出しぶら下げ{Step2．}{$G(x)=\log x+\bun{g(x)}{f(x)}$の正負・増減を調べる}
\sp
\noindent \ajLig{○注} ただし，$f(x)$の正負が一定な場合にしか使えない}}

\newcommand{\陰関数の微分}{\カラーポイント{陰関数の微分}{
\begin{enumerate}[\Kaku{enumi}]
\item 陽関数に直して微分
\item 合成関数の微分公式$\bun{\d}{\dx}=\bun{\dy}{\dx}\cdot\bun{\d}{\dy}$を用いて，\par 陰関数のまま微分
%\item 陽関数$y=\cdots$の形に直して微分する
%\item $\bun{\d}{\dx}=\bun{\dy}{\dx}\cdot\bun{\d}{\dy}$を利用する
\end{enumerate}}}

\newcommand{\対数微分法}{\カラーポイント{対数微分法}{
\mathindent=1zw
\見出しぶら下げ{Step1．}{$y=f(x)^{g(x)}$について，\波線強調{両辺正であることを確認した上で}，自然対数を取る
\[\log y=g(x)\log f(x)\]}
\見出しぶら下げ{Step2．}{両辺を$x$について微分する
\[&\underbrace{\bun{d}{dx}\log y}_{\bun{dy}{dx}\cdot\bun{d}{dy}\log y}=g'(x)\log f(x)+g(x)\bun{f'(x)}{f(x)}\\
\同値\ &\bun{dy}{dx}\cdot\bun{1}{y}=g'(x)\log f(x)+g(x)\bun{f'(x)}{f(x)}\]}
\見出しぶら下げ{Step3．}{求めたいのは$\bun{dy}{dx}$の値なので，
\[\bun{dy}{dx}=y\cdot \left\{g'(x)\log f(x)+g(x)\bun{f'(x)}{f(x)}\right\}\]}}}

\newcommand{\逆関数の微分}{\カラーポイント{逆関数の微分}{
\見出しぶら下げ{Step1．}{$y=f(x)$の$x$と$y$を入れ替える\ihspace{.5zw}\→\ihspace{.5zw}$x=f(y)$}
\見出しぶら下げ{Step2．}{両辺$x$で微分する
\begin{align*}
1=\bun{d}{dx}f(y)\同値{}&1=\bun{dy}{dx}\cdot\bun{d}{dy}f(y)\\
\同値{}&\bun{dy}{dx}=\bun{1}{\bun{d}{dy}f(y)}
\end{align*}}
\見出しぶら下げ{Step3．}{右辺は$y$の式で表されているので，$x=f(y)$を使って($x$の式)に直す}}}

