\同値 &\lim_{x\to a-0}\bun{f(x)-f(a)}{x-a}=\lim_{x\to a+0}\bun{f(x)-f(a)}{x-a}
\end{align*}
\sp
イメージ：「グラフが\波線{なめらかに}つながっている」}}

