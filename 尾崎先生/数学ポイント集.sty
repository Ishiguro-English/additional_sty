\newcommand{\完全順列}{\カラーポイント{完全順列}{
$X_1,\ X_2,\ \cdots,\ X_n$に$1,\ 2,\ \cdots n$の値を$1$つずつ対応させるとき，全ての$i\ (i=1,\ 2,\ \cdots n)$において，$X_i\neq i$が成立するような対応の数を$f_n$とすると，

{\番号付け変更[1]{\Kaku}
\begin{enumerate}<2zw>
\item $f_{n+2}=(n+1)(f_{n+1}+f_n)$
\item $f_n=n!\left\{1-\bun1{1!}+\bun1{2!}-\cdots+\bun{(-1)^n}{n!}\right\}$
\end{enumerate}
}}}

