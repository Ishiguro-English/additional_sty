        ]%
      }%
      {\twocolumn[\見出し{\テスト名\hfill{w\the週数 実施 \ }}]}%
    \stepcounter{テスト数}%
    \小見出し{平均点}\br{-.3}%
    \begin{center*}{\Large\平均 点}\\（\受験者数 名）\end{center*}%
  }%

