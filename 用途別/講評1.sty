\newcommand{\テスト}[1]%
  {%
    \def\平均の種類判定{テスト別}%
    \def\テスト名{#1}%
    \def\平均{\,--\,}\受験者{\,--\,}%
    \ifthenelse{\equal{\theテスト数}{1}}%
      {%
        \twocolumn[%
          \begin{asbox7}{\期 第\the週数 週配付\quad 講評}\end{asbox7}%
