%%% 大問番号・小問番号の描画フォーマットと自動幅計算
\def\bangoustyle@大問{\解答欄@styledaimonbangou}
\NewDocumentCommand{\default@大問@bangou}{}{%
  {\解答欄@fontdaimonbangou
   \ifx\bangoustyle@大問\@empty
     (\number\NUM@mondai)%
   \else
     \expandafter\csname \bangoustyle@大問\endcsname{\number\NUM@mondai}%
   \fi}%
}
\let\how@to@count@大問@bangou\default@大問@bangou

\NewDocumentCommand{\大問@bangou@yokotate}{}{%
  \def\rotate@or@not@大問{0}%
} 

% #1(省略可:幅倍率), #2(テキスト) から実効幅倍率 \解答欄@calc@wd@res を算出
\newcommand{\解答欄@calc@box@wd}[2]{%
  \sbox0{\scalebox{.8}{\ #2\ }}%
  \IfNoValueTF{#1}{%
    \pgfmathparse{max(1zw / \width@解答欄, (\wd0 + 0.15\width@解答欄) / \width@解答欄)}%
    \edef\解答欄@calc@wd@res{\pgfmathresult}%
  }{%
    \def\解答欄@calc@wd@res{#1}%
  }%
}

\NewDocumentCommand{\Daimon@Box@A@N}{ o m o }{% 大問番号
  \大問@bangou@yokotate%
  \IfNoValueTF{#3}{\global\advance\NUM@mondai by 1}{}%
  \edef\解答欄@cur@text{\IfNoValueTF{#3}{\noexpand\how@to@count@大問@bangou}{\unexpanded{#3}}}%
  \解答欄@calc@box@wd{#1}{\解答欄@cur@text}%
  \global\let\modai@bangou@wd\解答欄@calc@wd@res%
  \draw[line width=\waku@解答欄] (0,0) rectangle (\modai@bangou@wd\width@解答欄,- #2\width@解答欄);%
  \node[anchor=center,overlay
    ,rotate=\rotate@or@not@大問
  ]
   at (.5*\modai@bangou@wd\width@解答欄,- .5*#2\width@解答欄) {\scalebox{.8}{\ \解答欄@cur@text\ }};
  \pgfmathparse{\mondai@position@tmp + \modai@bangou@wd}%
  \edef\mondai@position@tmp{\pgfmathresult}%
}

\def\bangoustyle@小問{\解答欄@styleshoumonbangou}
\NewDocumentCommand{\default@小問@bangou}{}{%
  {\解答欄@fontshoumonbangou
   \ifx\bangoustyle@shoumon\@empty
     (\number\NUM@小問)%
   \else
     \expandafter\csname \bangoustyle@小問\endcsname{\number\NUM@小問}%
   \fi}%
}
\let\how@to@count@小問@bangou\default@小問@bangou

\NewDocumentCommand{\小問@bangou@yokotate}{}{%
  \def\rotate@or@not@小問{0}%
} 

\NewDocumentCommand{\Shoumon@Box@A@N}{ o m o }{% 小問番号
  \小問@bangou@yokotate%
  \IfNoValueTF{#3}{\advance\NUM@小問 by 1}{}%
  \edef\解答欄@cur@text{\IfNoValueTF{#3}{\noexpand\how@to@count@小問@bangou}{\unexpanded{#3}}}%
  \解答欄@calc@box@wd{#1}{\解答欄@cur@text}%
  \let\解答欄@小問@wd\解答欄@calc@wd@res%

  \draw[line width=\waku@解答欄] (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) -- ++ (0,- #2\width@解答欄);
  \draw[line width=\waku@解答欄] (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) -- ++ (\解答欄@小問@wd\width@解答欄,0);
  \draw[line width=\tensenwaku@解答欄, dash pattern=on \mondai@dash@pat@on off \mondai@dash@pat@off] (\mondai@position@tmp\width@解答欄+\解答欄@小問@wd\width@解答欄,-\mondai@position@y@tmp\width@解答欄) -- ++ (0,- #2\width@解答欄);
  \draw[line width=\waku@解答欄] (\mondai@position@tmp\width@解答欄+\解答欄@小問@wd\width@解答欄,-\mondai@position@y@tmp\width@解答欄- #2\width@解答欄) -- ++ (-\解答欄@小問@wd\width@解答欄,0);

  \node[anchor=center,overlay
    ,rotate=\rotate@or@not@小問
  ]
  at (\mondai@position@tmp\width@解答欄+.5*\解答欄@小問@wd\width@解答欄,-\mondai@position@y@tmp\width@解答欄- .5*#2\width@解答欄) {\scalebox{.8}{\ \解答欄@cur@text\ }};

  \pgfmathparse{\mondai@position@tmp + \解答欄@小問@wd}%
  \edef\mondai@position@tmp{\pgfmathresult}%
}


