%%% マス目テキスト用字間・サイズ調整 (LuaLaTeX / upLaTeX 対応)
\newcommand{\masume@text@解答欄}[1]{%
  \begingroup%
    \ifluatex
      \ltjsetparameter{kanjiskip=0pt}% 
      \ltjsetparameter{xkanjiskip=0pt}% 
    \else
      \kanjiskip=0pt\relax
      \xkanjiskip=0pt\relax
    \fi
    \解答欄@set@unitfont%
    {#1}% 
    \setlength{\lineskiplimit}{-99mm}%
    \par%
  \endgroup%
}
