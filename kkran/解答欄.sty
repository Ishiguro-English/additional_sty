%%% 縦書き判定の共通ラッパー
\newif\if解答欄@tate
\ifluatex
  \newcommand{\解答欄@check@tate}{%
    \ifnum\ltjgetparameter{direction}=3\relax
      \解答欄@tatetrue
    \else
      \解答欄@tatefalse
    \fi
  }
\else
  \newcommand{\解答欄@check@tate}{%
    \iftdir
      \解答欄@tatetrue
    \else
      \解答欄@tatefalse
