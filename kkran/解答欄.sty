%%% マークシート (自前の \graydaen / \filleddaen を使用)
\ExplSyntaxOn
\seq_new:N \l__解答欄_mark_tmp_seq
\seq_new:N \l__解答欄_mark_out_seq
\int_new:N \l__解答欄_mark_idx_int

\cs_new_protected:Npn \解答欄_register_mark_array:nn #1 #2
  {
    \seq_set_split:Nnn \l__解答欄_mark_tmp_seq { | } { #2 }
    \seq_remove_all:Nn \l__解答欄_mark_tmp_seq { }
    \seq_clear_new:c { g__解答欄_mark_#1_seq }
    \seq_gset_eq:cN { g__解答欄_mark_#1_seq } \l__解答欄_mark_tmp_seq
    \exp_args:Nc \NewDocumentCommand { #1マーク配列 } { O{0} }
      {
        \解答欄_render_mark_array:nn { #1 } { ##1 }
      }
  }

\cs_new_protected:Npn \解答欄_render_mark_array:nn #1 #2
  {
    \seq_clear:N \l__解答欄_mark_out_seq
    \int_zero:N \l__解答欄_mark_idx_int
    \seq_map_inline:cn { g__解答欄_mark_#1_seq }
      {
        \int_incr:N \l__解答欄_mark_idx_int
        \int_compare:nNnTF { \l__解答欄_mark_idx_int } = { #2 }
          {
            \ifnum\number\解答欄@解答表示=1\relax
              \sbox0{\graydaen{##1}}%
              \sbox2{\filleddaen}%
              \dim_set:Nn \l_tmpa_dim { (\ht0 - \dp0 - \ht2 + \dp2) / 2 }%
              \seq_put_right:Nn \l__解答欄_mark_out_seq
                { \makebox[\wd0]{\vphantom{\usebox0}\raisebox{\l_tmpa_dim}{\usebox2}} }
            \else
              \seq_put_right:Nn \l__解答欄_mark_out_seq { \graydaen{##1} }
            \fi
          }
          { \seq_put_right:Nn \l__解答欄_mark_out_seq { \graydaen{##1} } }
      }
    \seq_use:Nn \l__解答欄_mark_out_seq { \hfill }
  }

\NewDocumentCommand{\MarkArrayMake}{ m m }
  {
    \解答欄_register_mark_array:nn { #1 } { #2 }
  }
\ExplSyntaxOff

\NewDocumentCommand{\マークシート}{ m m o }{%
  \makebox[#1\unit@解答欄]{%
    \sffamily\gtfamily%
    \IfNoValueTF{#3}{%
