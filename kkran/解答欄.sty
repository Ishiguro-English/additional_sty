%%% rotation of the question numbers
\NewDocumentCommand{\RevBangou}{m}{%
  \解答欄@check@tate
  \if解答欄@tate
    \rotatebox[origin=c]{-90}{#1}%
  \else
    #1%
  \fi
} 
