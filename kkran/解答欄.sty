% 小問欄の横幅倍率を自動算出（#1: 省略可の幅倍率）
\newdimen\解答欄@ran@maxwd
\newcommand{\解答欄@calc@ran@wd@A}[1]{%
  \IfNoValueTF{#1}{%
    \解答欄@ran@maxwd=0pt\relax
    \sbox0{\westtext@Shoumon@Box@A}\ifdim\wd0>\解答欄@ran@maxwd \解答欄@ran@maxwd=\wd0\fi
    \sbox0{\centertext@Shoumon@Box@A}\ifdim\wd0>\解答欄@ran@maxwd \解答欄@ran@maxwd=\wd0\fi
    \sbox0{\easttext@Shoumon@Box@A}\ifdim\wd0>\解答欄@ran@maxwd \解答欄@ran@maxwd=\wd0\fi
    \sbox0{\nwtext@Shoumon@Box@A}\ifdim\wd0>\解答欄@ran@maxwd \解答欄@ran@maxwd=\wd0\fi
    \sbox0{\netext@Shoumon@Box@A}\ifdim\wd0>\解答欄@ran@maxwd \解答欄@ran@maxwd=\wd0\fi
    \sbox0{\swtext@Shoumon@Box@A}\ifdim\wd0>\解答欄@ran@maxwd \解答欄@ran@maxwd=\wd0\fi
    \sbox0{\setext@Shoumon@Box@A}\ifdim\wd0>\解答欄@ran@maxwd \解答欄@ran@maxwd=\wd0\fi
    \pgfmathparse{max(1, (\解答欄@ran@maxwd + 0.5\width@解答欄) / \width@解答欄)}%
    \edef\解答欄@ran@wd@res{\pgfmathresult}%
  }{%
    \def\解答欄@ran@wd@res{#1}%
  }%
}

\NewDocumentCommand{\Shoumon@Box@A}{ o m O{} }{% 小問（#1:省略可の幅倍率, #2:高さ倍率, #3:キーオプション）
  \reset@Shoumon@Box@A\setkeys{Shoumon@Box@A}{#3}%
  \解答欄@calc@ran@wd@A{#1}%
  \let\解答欄@ran@wd\解答欄@ran@wd@res%

  % 左上から反時計回りに A, B, C, D を定義
  \path (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) coordinate (A@Shoumon@Box@A)
        -- ++(0,-#2\width@解答欄) coordinate (B@Shoumon@Box@A)
        -- ++(\解答欄@ran@wd\width@解答欄,0)  coordinate (C@Shoumon@Box@A)
        -- ++(0,#2\width@解答欄)  coordinate (D@Shoumon@Box@A);

  % 箱の描画
  \draw[line width=\tensenwaku@解答欄, white] (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) -- ++ (0,- #2\width@解答欄);
  \draw[line width=\tensenwaku@解答欄, dash pattern=on \mondai@dash@pat@on off \mondai@dash@pat@off] (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) -- ++ (0,- #2\width@解答欄);
  \draw[line width=\waku@解答欄] (\mondai@position@tmp\width@解答欄-.5\tensenwaku@解答欄,-\mondai@position@y@tmp\width@解答欄) -- ++ (\解答欄@ran@wd\width@解答欄,0) -- ++ (0,- #2\width@解答欄) -- ++ (-\解答欄@ran@wd\width@解答欄-.5\tensenwaku@解答欄,0);

  % 文字列などの挿入用
  \node[overlay,anchor=center] at ($(A@Shoumon@Box@A)!0.5!(C@Shoumon@Box@A)$) {\centertext@Shoumon@Box@A};
  \node[overlay,anchor=west] at ($(A@Shoumon@Box@A)!0.5!(B@Shoumon@Box@A)$) {\westtext@Shoumon@Box@A};
  \node[overlay,anchor=east] at ($(C@Shoumon@Box@A)!0.5!(D@Shoumon@Box@A)$) {\easttext@Shoumon@Box@A};
  \node[overlay,anchor=north west] at (A@Shoumon@Box@A) {\nwtext@Shoumon@Box@A};
  \node[overlay,anchor=north east] at (D@Shoumon@Box@A) {\netext@Shoumon@Box@A};
  \node[overlay,anchor=south west] at (B@Shoumon@Box@A) {\swtext@Shoumon@Box@A};
  \node[overlay,anchor=south east] at (C@Shoumon@Box@A) {\setext@Shoumon@Box@A};

  % 座標の更新
  \pgfmathparse{\mondai@position@tmp + \解答欄@ran@wd}%
  \edef\mondai@position@tmp{\pgfmathresult}%
}


