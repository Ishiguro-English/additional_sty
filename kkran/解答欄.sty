%%% KaitouInput（赤文字の解答部分のみ少し小さめのサイズを適用）
\NewDocumentCommand{\KaitouInput}{m}{%
  \ifnum\number\解答欄@解答表示=1\relax
    {\解答欄@set@kaitoufont\color{\解答欄@kaitoucolor}#1}%
  \else
    \ifnum\number\解答欄@解答表示=0\relax
      {\解答欄@set@kaitoufont\color{white}#1}%
    \else
      \errmessage{Error: 解答表示 option requires to be 0 or 1.}%
    \fi
  \fi
}
