%%% 共通フォントサイズ設定
% マス目基準（1zw = \unit@解答欄）
\newcommand{\解答欄@set@unitfont}{%
  \setlength{\baselineskip}{\dimexpr\unit@解答欄\relax}%
  \fontsize{\unit@解答欄}{\baselineskip}\selectfont%
  \pgfmathparse{(\unit@解答欄 / 1zw) * \unit@解答欄}%
  \fontsize{\pgfmathresult pt}{\baselineskip}\selectfont%
}

% 解答出力（赤文字）用：マス目より少し小さめ（0.85倍）
\newcommand{\解答欄@set@kaitoufont}{%
  \setlength{\baselineskip}{\dimexpr\unit@解答欄\relax}%
  \fontsize{\unit@解答欄}{\baselineskip}\selectfont%
  \pgfmathparse{0.85 * (\unit@解答欄 / 1zw) * \unit@解答欄}%
  \fontsize{\pgfmathresult pt}{\baselineskip}\selectfont%
}
