%%% 外枠
\newcommand{\BlockFillMode@解答欄}{%
  % \Daimon@Box@A@N のパッチ
  \RenewDocumentCommand{\Daimon@Box@A@N}{ o m o }{%
    \IfNoValueTF{##3}{\global\advance\NUM@mondai by 1}{}%
    \edef\解答欄@cur@text{\IfNoValueTF{##3}{\noexpand\how@to@count@大問@bangou}{\unexpanded{##3}}}%
    \解答欄@calc@box@wd{##1}{\解答欄@cur@text}%
    \global\let\modai@bangou@wd\解答欄@calc@wd@res%
    \fill (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) 
          rectangle ++(\modai@bangou@wd\width@解答欄, -##2\width@解答欄);%
    \pgfmathparse{\mondai@position@tmp + \modai@bangou@wd}%
    \edef\mondai@position@tmp{\pgfmathresult}%
  }%
  
  % Shoumon@Box@A@N のパッチ
  \RenewDocumentCommand{\Shoumon@Box@A@N}{ o m o }{%
    \IfNoValueTF{##3}{\advance\NUM@小問 by 1}{}%
    \edef\解答欄@cur@text{\IfNoValueTF{##3}{\noexpand\how@to@count@小問@bangou}{\unexpanded{##3}}}%
    \解答欄@calc@box@wd{##1}{\解答欄@cur@text}%
    \let\解答欄@小問@wd\解答欄@calc@wd@res%
    \fill (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) 
          rectangle ++(\解答欄@小問@wd\width@解答欄, -##2\width@解答欄);%
    \pgfmathparse{\mondai@position@tmp + \解答欄@小問@wd}%
    \edef\mondai@position@tmp{\pgfmathresult}%
  }%
  
  % Shoumon@Box@A のパッチ
  \RenewDocumentCommand{\Shoumon@Box@A}{ o m O{} }{%
    \reset@Shoumon@Box@A\setkeys{Shoumon@Box@A}{##3}%
    \解答欄@calc@ran@wd@A{##1}%
    \let\解答欄@ran@wd\解答欄@ran@wd@res%
    \fill (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) 
          rectangle ++(\解答欄@ran@wd\width@解答欄, -##2\width@解答欄);%
    \pgfmathparse{\mondai@position@tmp + \解答欄@ran@wd}%
    \edef\mondai@position@tmp{\pgfmathresult}%
  }%

  % Shoumon@Box@B のパッチ
  \RenewDocumentCommand{\Shoumon@Box@B}{ o m O{} }{%
    \reset@Shoumon@Box@B\setkeys{Shoumon@Box@B}{##3}%
    \解答欄@calc@ran@wd@B{##1}%
    \let\解答欄@ran@wd\解答欄@ran@wd@res%
    \fill (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) 
          rectangle ++(\解答欄@ran@wd\width@解答欄, -##2\width@解答欄);%
    \pgfmathparse{\mondai@position@tmp + \解答欄@ran@wd}%
    \edef\mondai@position@tmp{\pgfmathresult}%
  }%

  % Shoumon@Grid@A
  \RenewDocumentCommand{\Shoumon@Grid@A}{ O{##2} m O{}}{%
    \def\grid@max@A{##2}\def\grid@min@A{##1}%
    \def\grid@x@A{\解答欄@gridmax}%
    \pgfmathtruncatemacro{\shou@grid@max@A}{\grid@max@A / \grid@x@A}%
    \pgfmathtruncatemacro{\amari@grid@max@A}{mod(\grid@max@A,\grid@x@A)}%
    \pgfmathtruncatemacro{\max@minus@amari@grid@max@A}{\grid@x@A-\amari@grid@max@A}%
    \pgfmathtruncatemacro{\shou@grid@min@A}{\grid@min@A / \grid@x@A}%
    \pgfmathtruncatemacro{\amari@grid@min@A}{mod(\grid@min@A,\grid@x@A)}%
    \pgfmathtruncatemacro{\min@minus@amari@grid@min@A}{\grid@x@A-\amari@grid@min@A}%
    
    \ifnum\grid@max@A<\grid@x@A\relax
      \fill
      (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄-\unit@解答欄) --
      (\mondai@position@tmp\width@解答欄+\amari@grid@max@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\unit@解答欄) --
      (\mondai@position@tmp\width@解答欄+\amari@grid@max@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄+\shou@grid@max@A\unit@解答欄) --
      (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄+\shou@grid@max@A\unit@解答欄) -- cycle;
    \else
      \ifnum\amari@grid@max@A=0\relax
        \fill
          (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@grid@max@A\unit@解答欄) --
          (\mondai@position@tmp\width@解答欄+\grid@x@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@grid@max@A\unit@解答欄) --
          (\mondai@position@tmp\width@解答欄+\grid@x@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄) --
          (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) -- cycle;
      \else
        \coordinate (A@amari@non@zero) at (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄);%
        \coordinate (B@amari@non@zero) at (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@grid@max@A\unit@解答欄-\unit@解答欄);%
        \coordinate (C@amari@non@zero) at (\mondai@position@tmp\width@解答欄+\amari@grid@max@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@grid@max@A\unit@解答欄-\unit@解答欄);%
        \coordinate (D@amari@non@zero) at (\mondai@position@tmp\width@解答欄+\amari@grid@max@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@grid@max@A\unit@解答欄);%
        \coordinate (E@amari@non@zero) at (\mondai@position@tmp\width@解答欄+\grid@x@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@grid@max@A\unit@解答欄);%
        \coordinate (F@amari@non@zero) at (\mondai@position@tmp\width@解答欄+\grid@x@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄);%
        \fill (B@amari@non@zero) -- (C@amari@non@zero)
        -- (D@amari@non@zero) -- (E@amari@non@zero) -- (F@amari@non@zero) -- (A@amari@non@zero) -- cycle;
      \fi
    \fi
  }

  % Shoumon@NonGrid@A
  \RenewDocumentCommand{\Shoumon@NonGrid@A}{ m O{}}{%
    \def\nongrid@max@A{##1}
    \def\nongrid@x@A{\解答欄@nongridmax}%
    \pgfmathtruncatemacro{\shou@nongrid@max@A}{\nongrid@max@A / \nongrid@x@A}% 
    \pgfmathtruncatemacro{\amari@nongrid@max@A}{mod(\nongrid@max@A,\nongrid@x@A)}%
    \pgfmathtruncatemacro{\max@minus@amari@nongrid@max@A}{\nongrid@x@A-\amari@nongrid@max@A}% 
    
    \ifnum\nongrid@max@A<\nongrid@x@A\relax
      \fill
      (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄-\unit@解答欄) --
      (\mondai@position@tmp\width@解答欄+\amari@nongrid@max@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\unit@解答欄) --
      (\mondai@position@tmp\width@解答欄+\amari@nongrid@max@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄+\shou@nongrid@max@A\unit@解答欄) --
      (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄+\shou@nongrid@max@A\unit@解答欄) -- cycle;
      
      \pgfmathparse{\mondai@position@tmp + \nongrid@max@A}%
      \edef\mondai@position@tmp{\pgfmathresult}%
    \else
      \ifnum\amari@nongrid@max@A=0\relax
        \fill
          (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@nongrid@max@A\unit@解答欄) --
          (\mondai@position@tmp\width@解答欄+\nongrid@x@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@nongrid@max@A\unit@解答欄) --
          (\mondai@position@tmp\width@解答欄+\nongrid@x@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄) --
          (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄) -- cycle;

        \pgfmathparse{\mondai@position@tmp + \nongrid@x@A}%
        \edef\mondai@position@tmp{\pgfmathresult}%
      \else
        \coordinate (A@amari@non@zero) at (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄);%
        \coordinate (B@amari@non@zero) at (\mondai@position@tmp\width@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@nongrid@max@A\unit@解答欄-\unit@解答欄);%
        \coordinate (C@amari@non@zero) at (\mondai@position@tmp\width@解答欄+\amari@nongrid@max@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@nongrid@max@A\unit@解答欄-\unit@解答欄);%
        \coordinate (D@amari@non@zero) at (\mondai@position@tmp\width@解答欄+\amari@nongrid@max@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@nongrid@max@A\unit@解答欄);%
        \coordinate (E@amari@non@zero) at (\mondai@position@tmp\width@解答欄+\nongrid@x@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄-\shou@nongrid@max@A\unit@解答欄);%
        \coordinate (F@amari@non@zero) at (\mondai@position@tmp\width@解答欄+\nongrid@x@A\unit@解答欄,-\mondai@position@y@tmp\width@解答欄);%
        \fill (B@amari@non@zero) -- (C@amari@non@zero)
        -- (D@amari@non@zero) -- (E@amari@non@zero) -- (F@amari@non@zero) -- (A@amari@non@zero) -- cycle;

        \pgfmathparse{\mondai@position@tmp + \nongrid@x@A}%
        \edef\mondai@position@tmp{\pgfmathresult}%
      \fi
    \fi
  }
